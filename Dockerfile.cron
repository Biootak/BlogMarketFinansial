# ============================================================================
# Sidecar cron image for self-hosted Docker deploy.
# ----------------------------------------------------------------------------
# به جای نصب system cron روی host، این image یک کانتینر کوچک دارد که هر
# دقیقه endpointهای داخلی اپ را صدا می‌زند.
#
# 2026-08-16: از dcron به حلقه‌ی shell مهاجرت شد — dcron در کانتینر Alpine
# با «setpgid: Operation not permitted» کرش می‌کرد. ر.ک deploy/cron-loop.sh
#
# استفاده در docker-compose.yml:
#   services:
#     cron:
#       build:
#         context: .
#         dockerfile: Dockerfile.cron
#       environment:
#         - APP_URL=http://web:3000
#         - CRON_SECRET=${CRON_SECRET}
#       depends_on:
#         - web
# ============================================================================
# روی VPS خارجی: CRON_IMAGE=alpine:3.20 را در .env ست کن (Docker Hub رسمی)
ARG CRON_IMAGE=registry.docker.ir/alpine:3.20
FROM ${CRON_IMAGE}

RUN apk add --no-cache curl

# حلقه‌ی cron (جایگزین dcron)
COPY deploy/cron-loop.sh /usr/local/bin/cron-loop.sh
RUN chmod 0755 /usr/local/bin/cron-loop.sh

CMD ["/usr/local/bin/cron-loop.sh"]
