datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "windows", "debian-openssl-3.0.x", "rhel-openssl-3.0.x"]
}

enum Role {
  USER
  AUTHOR
  ADMIN
  OWNER
}

enum PostType {
  STANDARD
  VIDEO
  GALLERY
  AUDIO
}

enum PostStatus {
  DRAFT
  PENDING_REVIEW
  // 2026-07-04: وضعیت جدید برای پست‌هایی که زمان انتشار آینده دارند.
  // توسط owner/admin تنظیم می‌شود (AUTHOR → PENDING_REVIEW).
  SCHEDULED
  PUBLISHED
}

enum AdSize {
  SMALL
  MEDIUM
  LARGE
  CUSTOM
}

enum AdPosition {
  HEADER
  FOOTER
  SIDEBAR
  IN_CONTENT
  BETWEEN_POSTS
  CUSTOM
}

enum RateType {
  BUY_SELL
  SINGLE_BULK
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  role          Role      @default(USER)
  status        String    @default("Active")
  password      String?
  emailVerified DateTime?
  phoneNumber   String?
  image         String?
  // 2026-06-21: ابعاد تصویر پروفایل برای CLS-safe رندر + انتخاب variant
  imageWidth    Int?
  imageHeight   Int?

  accounts      Account[]
  sessions      Session[]
  posts         Post[]
  comments      Comment[]
  likes         Like[]
  savedPosts    SavedPost[]
  profile       Profile?
  notifications Notification[]
  newsletter    Newsletter[]
  activities    ActivityLog[]
  activity      Activity[]
  tasks         Task[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // 2026-06-14: hot paths — system reports filters by status (Active),
  // dashboard user lists filter by role + status, and full-text
  // searches fall back to these without an index. Each one was a
  // seq scan before.
  @@index([status])
  @@index([role, status])
  @@index([phoneNumber])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// 2026-06-23: unified OTP model.
// Token is a 6-digit string ("472938") — used by all auth flows:
// register / login (passwordless OAuth-only users) / reverify / recover.
// UUID v4 token flow has been retired.
model VerificationToken {
  id       String   @id @default(cuid())
  email    String
  token    String   @unique
  expires  DateTime
  // Brute-force counter — max 5 attempts before the token is invalidated.
  // Lets us send a refreshing code while keeping attempt-budget per code.
  attempts Int      @default(0)
  // Why this code was issued. Drives both server-side effects after a
  // successful verify (set emailVerified, create user, etc.) and the
  // email copy. Keep values in sync with VerificationEmailIntent in
  // src/lib/tokens.ts.
  intent   String   @default("register")

  // 2026-06-24: enforce at most one active OTP per (email, intent).
  // Without this, a race could mint two 'register' tokens for the same
  // email and consumeOtpToken couldn't tell which was authoritative.
  // The (email, token) unique is kept as a defense-in-depth so the
  // same 6-digit code can't be issued twice under the same email.
  @@unique([email, intent])
  @@unique([email, token])
  @@index([email])
  @@index([expires])
}

model Profile {
  id      String  @id @default(cuid())
  bio     String?
  avatar  String?
  bgImage String?
  // 2026-06-21: ابعاد تصاویر پروفایل برای CLS-safe رندر
  avatarWidth  Int?
  avatarHeight Int?
  bgImageWidth Int?
  bgImageHeight Int?
  jobName String?
  company String?
  userId  String  @unique
  user    User    @relation(fields: [userId], references: [id])
}

model Post {
  id            String     @id @default(cuid())
  title         String
  content       String
  excerpt       String?
  slug          String     @unique
  isFeatured    Boolean    @default(false)
  status        PostStatus @default(DRAFT)
  featuredImage String?
  // 2026-06-21: ابعاد تصویر شاخص برای CLS-safe رندر + انتخاب variant responsive
  featuredImageWidth  Int?
  featuredImageHeight Int?
  galleryImages String[]   @default([])
  postType      PostType   @default(STANDARD)
  videoUrl      String?
  audioUrl      String?
  authorId      String
  viewCount     Int        @default(0)
  readingTime   Int        @default(0)
  // 2026-07-04: تاریخ/زمان انتشار برنامه‌ریزی‌شده. null یعنی بدون برنامه.
  // تقویم انتشار (`AtelierMonthCalendar`) از این فیلد برای bucketing
  // استفاده می‌کند؛ اگر null باشد، `createdAt` جایگزین می‌شود.
  scheduledAt   DateTime?

  author     User        @relation(fields: [authorId], references: [id])
  comments   Comment[]
  categories Category[]
  tags       Tag[]
  likes      Like[]
  savedBy    SavedPost[]
  views      View[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([authorId])
  @@index([createdAt])
  @@index([isFeatured])
  // 2026-07-04: برای کوئری‌های تقویم انتشار (پنجرهٔ گسترده روی scheduledAt).
  @@index([scheduledAt])
  // 2026-06-14: composite indexes for the hot read paths.
  // The archive page + home always filter by status, then sort by
  // createdAt (or likes count) — single-column indexes force the
  // planner to either filter or sort, never both. The (status, createdAt)
  // and (status, viewCount) pairs let Postgres do an index-only scan.
  @@index([status, createdAt(sort: Desc)])
  @@index([status, viewCount(sort: Desc)])
  @@index([status, isFeatured, createdAt(sort: Desc)])
  // For author-scoped listings (e.g. dashboard AUTHOR role).
  @@index([authorId, status, createdAt(sort: Desc)])
  // For full-text search later (pg_trgm or tsvector).
  @@index([title])
}

model View {
  id        String  @id @default(cuid())
  postId    String
  post      Post    @relation(fields: [postId], references: [id])
  ip        String?
  userAgent String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([postId])
  @@index([createdAt])
}

model Comment {
  id       String  @id @default(cuid())
  content  String
  postId   String
  authorId String
  parentId String?
  approved Boolean @default(false)

  post    Post      @relation(fields: [postId], references: [id])
  author  User      @relation(fields: [authorId], references: [id])
  parent  Comment?  @relation("CommentToComment", fields: [parentId], references: [id])
  replies Comment[] @relation("CommentToComment")
  likes   Like[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([postId])
  @@index([authorId])
  @@index([approved])
  // 2026-06-14: composite index for the per-post approved-comments list
  // (rendered in the comments section of single post pages).
  @@index([postId, approved, createdAt(sort: Desc)])
  // For the dashboard activity log (latest comments by a user).
  @@index([authorId, createdAt(sort: Desc)])
}

model Like {
  id        String  @id @default(cuid())
  userId    String
  postId    String?
  commentId String?

  user    User     @relation(fields: [userId], references: [id])
  post    Post?    @relation(fields: [postId], references: [id])
  comment Comment? @relation(fields: [commentId], references: [id])

  createdAt DateTime @default(now())

  @@unique([userId, postId, commentId])
  // 2026-06-14: per-post like counts are sorted on the archive (محبوب‌ترین)
  // and home sections. Without these, Postgres falls back to a seq scan
  // + groupBy, which is O(n) on every archive page load.
  @@index([postId, createdAt(sort: Desc)])
  @@index([commentId, createdAt(sort: Desc)])
  @@index([userId, createdAt(sort: Desc)])
}

model Category {
  id               String     @id @default(cuid())
  name             String
  slug             String     @unique
  thumbnail        String?
  // 2026-06-21: ابعاد thumbnail برای CLS-safe رندر
  thumbnailWidth   Int?
  thumbnailHeight  Int?
  posts            Post[]
  parentCategories Category[] @relation("CategoryToParent")
  childCategories  Category[] @relation("CategoryToParent")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Tag {
  id        String  @id @default(cuid())
  name      String  @unique
  slug      String  @unique
  thumbnail String?
  // 2026-06-21: ابعاد thumbnail برای CLS-safe رندر
  thumbnailWidth   Int?
  thumbnailHeight  Int?
  posts     Post[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SavedPost {
  id     String @id @default(cuid())
  userId String
  postId String

  user User @relation(fields: [userId], references: [id])
  post Post @relation(fields: [postId], references: [id])

  createdAt DateTime @default(now())

  @@unique([userId, postId])
  // 2026-06-14: used by getStats() weekly groupBy and by user profile pages.
  @@index([createdAt(sort: Desc)])
  @@index([postId, createdAt(sort: Desc)])
}

model Notification {
  id        Int      @id @default(autoincrement())
  message   String
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())

  // 2026-06-14: notification dropdowns always do
  // `findMany({ where: { userId }, orderBy: { createdAt: 'desc' }, take })`.
  // Without this index the planner had to seq-scan the whole table
  // and sort. The composite covers both the filter and the order.
  @@index([userId, createdAt(sort: Desc)])
}

model Advertisement {
  id               String     @id @default(cuid())
  title            String
  description      String?
  imageUrl         String
  linkUrl          String
  startDate        DateTime
  endDate          DateTime
  isActive         Boolean    @default(true)
  size             AdSize     @default(MEDIUM)
  position         AdPosition @default(IN_CONTENT)
  customPosition   String?
  order            Int        @default(0)
  customDimensions Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // 2026-06-14: getActiveAdvertisements filters on (isActive, startDate, endDate)
  // and orders by (position, order). Postgres needs the composite to
  // use an index-only scan; before this it was a full scan + filter.
  @@index([isActive, startDate, endDate])
  @@index([position, order])
}

model ExchangeRate {
  id          String   @id @default(cuid())
  name        String   @unique
  currency    String
  // 2026-06-20: اضافه شدن فیلدهای registry — symbol, displayNameFa, group, unit,
  // divisor, decimals, priority, provider, tgjuKey, active
  symbol      String?  @unique
  displayNameFa String?
  group       String?
  unit        String?
  divisor     Int      @default(1)
  decimals    Int      @default(0)
  priority    Int      @default(99)
  provider    String   @default("auto")
  tgjuKey     String?
  active      Boolean  @default(true)

  rateType    RateType @default(BUY_SELL)
  buyRate     String?
  sellRate    String?
  singleRate  String?
  bulkRate    String?
  description String?
  imageUrl    String?
  manualNote  String?
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())

  @@index([createdAt(sort: Desc)])
  @@index([active, priority])
  @@index([symbol])
}

model RateList {
  id        String   @id @default(cuid())
  title     String
  rates     Json // Array of { title: string, value: string }
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // 2026-06-14: dashboard rate-list page filters on isActive and
  // sorts by createdAt. The composite lets it run as an index scan
  // without an extra sort step.
  @@index([isActive, createdAt(sort: Desc)])
}

model PageView {
  id    String   @id @default(cuid())
  page  String
  views Int
  date  DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // 2026-07-04: switch the uniqueness key from `[page]` to `[page, date]`
  // so /api/pageview can upsert a single daily bucket per URL. The
  // previous `[page]` unique forced every page into one row, which made
  // `groupBy({by: ['date']})` in getViewStatsByPeriod return only the
  // seed rows (8 buckets) — leaving 30d/90d charts effectively empty
  // and breaking `todayViews` which relied on `createdAt >= today`.
  //
  // With `[page, date]` the upsert becomes `where: { page_date: { page, date } }`
  // and each day gets its own row. The `@@index([date])` keeps the
  // groupBy-by-date query an index scan.
  @@unique([page, date])
  @@index([date])
}

model Newsletter {
  id        String   @id @default(cuid())
  email     String   @unique
  isActive  Boolean  @default(true)
  userId    String?  @unique
  user      User?    @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SystemSettings {
  id              String   @id @default(cuid())
  siteName        String?
  siteDescription String?
  logoUrl         String?
  maintenanceMode Boolean  @default(false)
  cacheEnabled    Boolean  @default(true)
  smtpServer      String?
  smtpPort        String?
  smtpUsername    String?
  smtpPassword    String?
  telegram        String?
  instagram       String?
  whatsapp        String?
  twitter         String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model SystemLog {
  id        String   @id @default(cuid())
  level     String // ERROR, WARNING, INFO
  message   String   @db.Text
  source    String
  timestamp DateTime @default(now())

  @@index([timestamp])
}

model ActivityLog {
  id        String   @id @default(cuid())
  userId    String
  action    String
  details   String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])

  // 2026-06-28: composite index for user-scoped activity feeds sorted by time.
  // Replaces separate indexes; covers userId filters + createdAt ordering.
  @@index([userId, createdAt])
}

model Activity {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  action    String
  details   String
  createdAt DateTime @default(now())

  @@index([userId])
}

model CurrencyPattern {
  id        String   @id @default(cuid())
  type      String // نوع الگو: currency, format, prefix, suffix, separator, multiplier
  pattern   String // الگوی ذخیره شده
  value     Float? // برای multiplier استفاده می‌شود
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([type, pattern])
}

model SocialLink {
  id        String         @id @default(cuid())
  name      String
  url       String
  icon      String?
  // 2026-06-21: ابعاد آیکون برای CLS-safe رندر
  iconWidth  Int?
  iconHeight Int?
  color     String?
  order     Int            @default(0)
  isActive  Boolean        @default(true)
  type      SocialLinkType @default(SOCIAL)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  // 2026-06-14: header/footer always render
  //   where: { type, isActive: true }, orderBy: { order: 'asc' }
  // The composite covers both the filter and the sort in one pass.
  @@index([type, isActive, order])
}

enum SocialLinkType {
  SOCIAL
  SUPPORT
}

enum ServiceRequestStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum ServiceType {
  INTERNATIONAL_TRANSFER
  ONLINE_PAYMENT
  TUITION_PAYMENT
  FREELANCE_INCOME
  SOFTWARE_PURCHASE
  OTHER
}

enum RequestUrgency {
  NORMAL
  URGENT
}

model ServiceRequest {
  id            String               @id @default(cuid())
  trackingCode  String               @unique
  fullName      String
  phone         String
  email         String?
  serviceType   ServiceType
  amount        String
  currency      String
  description   String?
  urgency       RequestUrgency       @default(NORMAL)
  contactMethod String // telegram or whatsapp
  status        ServiceRequestStatus @default(PENDING)
  adminNotes    String?
  ipAddress     String?
  userAgent     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([trackingCode])
  @@index([phone])
  @@index([status])
  @@index([createdAt])
  // 2026-06-14: composite for the duplicate-check window
  // (createServiceRequest was doing a findFirst on these four fields
  // and we want it index-only).
  @@index([phone, amount, currency, createdAt])
  // 2026-06-14: dashboard's status-grouped counts + recent-list
  // combination — covers `where: { status }, orderBy: { createdAt }`.
  @@index([status, createdAt(sort: Desc)])
}

enum HeaderAdVariant {
  // متن ساده + دکمه CTA (سفارشی)
  TEXT
  // تصویر بنر + لینک
  IMAGE
  // ترکیبی: متن + تصویر
  MIXED
}

enum HeaderAdTheme {
  PRIMARY
  ACCENT
  NEUTRAL
  DARK
  GRADIENT
}

/// 2026-06-14: تبلیغ باریک بالای هدر.
/// فقط یک ردیف فعال در لحظه (singleton).
/// کاربر می‌تواند با دکمه × آن را برای session ببندد
/// (کوکی client-side — در سرور نگه‌داری نمی‌شود).
model HeaderAd {
  id       String          @id @default(cuid())
  text     String // متن اصلی تبلیغ (فارسی)
  subtext  String? // متن فرعی اختیاری
  ctaLabel String? // متن دکمه CTA (مثلاً «بیشتر بدانید»)
  ctaHref  String? // لینک CTA
  imageUrl String? // اختیاری: لوگو/آیکن
  href     String? // اختیاری: لینک کل بنر
  variant  HeaderAdVariant @default(TEXT)
  theme    HeaderAdTheme   @default(PRIMARY)
  isActive Boolean         @default(false) // singleton: فقط یکی فعال باشد
  priority Int             @default(0) // برای ترتیب نمایش در آینده

  startDate DateTime?
  endDate   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive, startDate, endDate])
  @@index([priority])
}

model Task {
  id          String       @id @default(cuid())
  title       String
  description String?
  status      TaskStatus   @default(PENDING)
  priority    TaskPriority @default(MEDIUM)
  dueDate     DateTime?
  userId      String
  user        User         @relation(fields: [userId], references: [id])
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  // User dashboard — filter by status, sort by recency
  @@index([userId, status, createdAt(sort: Desc)])
  // User tasks sorted by due date (deadline views)
  @@index([userId, dueDate])
  // Overdue task queries (admin/cron)
  @@index([status, dueDate])
}

enum TaskStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}
