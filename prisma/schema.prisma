generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "windows", "debian-openssl-3.0.x", "rhel-openssl-3.0.x", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                  String                @id @default(cuid())
  name                String?
  email               String                @unique
  role                Role                  @default(USER)
  status              String                @default("Active")
  password            String?
  emailVerified       DateTime?
  phoneNumber         String?
  image               String?
  imageWidth          Int?
  imageHeight         Int?
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
  nationalIdHash      String?
  kycSubmittedAt      DateTime?
  kycReviewedAt       DateTime?
  kycRejectReason     String?
  kycDocUrl           String?
  twoFactorEnabled    Boolean               @default(false)
  twoFactorSecret     String?
  twoFactorSecretEnc  String?
  exchangePartnerId   String?
  tokenVersion        Int                   @default(0)
  accounts            Account[]
  activity            Activity[]
  activities          ActivityLog[]
  Beneficiary         Beneficiary[]
  BillingAddress      BillingAddress?
  comments            Comment[]
  Customer            Customer?
  ExchangeStaff       ExchangeStaff[]
  KycRecord           KycRecord?
  likes               Like[]
  newsletter          Newsletter?
  notifications       Notification[]
  posts               Post[]
  profile             Profile?
  savedPosts          SavedPost[]
  serviceRequests     ServiceRequest[]
  sessions            Session[]
  tasks               Task[]
  TwoFactorBackupCode TwoFactorBackupCode[]
  VirtualCard         VirtualCard[]

  @@index([status])
  @@index([role, status])
  @@index([phoneNumber])
  @@index([exchangePartnerId])
}

model Account {
  id                String   @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime
  deviceId     String?
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([deviceId])
}

model VerificationToken {
  id       String   @id @default(cuid())
  email    String
  token    String   @unique
  expires  DateTime
  attempts Int      @default(0)
  intent   String   @default("register")

  @@unique([email, intent])
  @@unique([email, token])
  @@index([email])
  @@index([expires])
}

model Profile {
  id            String  @id @default(cuid())
  bio           String?
  avatar        String?
  bgImage       String?
  avatarWidth   Int?
  avatarHeight  Int?
  bgImageWidth  Int?
  bgImageHeight Int?
  jobName       String?
  company       String?
  userId        String  @unique
  user          User    @relation(fields: [userId], references: [id])
}

model Post {
  id                  String      @id @default(cuid())
  title               String
  content             String
  excerpt             String?
  slug                String      @unique
  isFeatured          Boolean     @default(false)
  status              PostStatus  @default(DRAFT)
  featuredImage       String?
  featuredImageWidth  Int?
  featuredImageHeight Int?
  galleryImages       String[]    @default([])
  postType            PostType    @default(STANDARD)
  videoUrl            String?
  audioUrl            String?
  authorId            String
  viewCount           Int         @default(0)
  readingTime         Int         @default(0)
  scheduledAt         DateTime?
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt
  comments            Comment[]
  likes               Like[]
  author              User        @relation(fields: [authorId], references: [id])
  savedBy             SavedPost[]
  views               View[]
  categories          Category[]  @relation("CategoryToPost")
  tags                Tag[]       @relation("PostToTag")

  @@index([status])
  @@index([authorId])
  @@index([createdAt])
  @@index([isFeatured])
  @@index([scheduledAt])
  @@index([status, createdAt(sort: Desc)])
  @@index([status, viewCount(sort: Desc)])
  @@index([status, isFeatured, createdAt(sort: Desc)])
  @@index([authorId, status, createdAt(sort: Desc)])
  @@index([title])
}

model View {
  id        String   @id @default(cuid())
  postId    String
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  post      Post     @relation(fields: [postId], references: [id])

  @@index([postId])
  @@index([createdAt])
}

model Comment {
  id        String    @id @default(cuid())
  content   String
  postId    String
  authorId  String
  parentId  String?
  approved  Boolean   @default(false)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  author    User      @relation(fields: [authorId], references: [id])
  parent    Comment?  @relation("CommentToComment", fields: [parentId], references: [id])
  replies   Comment[] @relation("CommentToComment")
  post      Post      @relation(fields: [postId], references: [id])
  likes     Like[]

  @@index([postId])
  @@index([authorId])
  @@index([approved])
  @@index([postId, approved, createdAt(sort: Desc)])
  @@index([authorId, createdAt(sort: Desc)])
}

model Like {
  id        String   @id @default(cuid())
  userId    String
  postId    String?
  commentId String?
  createdAt DateTime @default(now())
  comment   Comment? @relation(fields: [commentId], references: [id])
  post      Post?    @relation(fields: [postId], references: [id])
  user      User     @relation(fields: [userId], references: [id])

  @@unique([userId, postId])
  @@unique([userId, commentId])
  @@index([postId, createdAt(sort: Desc)])
  @@index([commentId, createdAt(sort: Desc)])
  @@index([userId, createdAt(sort: Desc)])
}

model Category {
  id               String     @id @default(cuid())
  name             String
  slug             String     @unique
  thumbnail        String?
  thumbnailWidth   Int?
  thumbnailHeight  Int?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
  childCategories  Category[] @relation("CategoryToParent")
  parentCategories Category[] @relation("CategoryToParent")
  posts            Post[]     @relation("CategoryToPost")
}

model Tag {
  id              String   @id @default(cuid())
  name            String   @unique
  slug            String   @unique
  thumbnail       String?
  thumbnailWidth  Int?
  thumbnailHeight Int?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  posts           Post[]   @relation("PostToTag")
}

model SavedPost {
  id        String   @id @default(cuid())
  userId    String
  postId    String
  createdAt DateTime @default(now())
  post      Post     @relation(fields: [postId], references: [id])
  user      User     @relation(fields: [userId], references: [id])

  @@unique([userId, postId])
  @@index([createdAt(sort: Desc)])
  @@index([postId, createdAt(sort: Desc)])
}

model Notification {
  id        Int      @id @default(autoincrement())
  message   String
  userId    String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])

  @@index([createdAt])
  @@index([userId, createdAt(sort: Desc)])
}

model Advertisement {
  id               String     @id @default(cuid())
  title            String
  description      String?
  imageUrl         String
  linkUrl          String
  startDate        DateTime
  endDate          DateTime
  isActive         Boolean    @default(true)
  size             AdSize     @default(MEDIUM)
  position         AdPosition @default(IN_CONTENT)
  customPosition   String?
  order            Int        @default(0)
  customDimensions Json?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  @@index([isActive, startDate, endDate])
  @@index([position, order])
}

model ExchangeRate {
  id            String   @id @default(cuid())
  name          String   @unique
  currency      String
  symbol        String?  @unique
  displayNameFa String?
  group         String?
  unit          String?
  divisor       Int      @default(1)
  decimals      Int      @default(0)
  priority      Int      @default(99)
  provider      String   @default("auto")
  tgjuKey       String?
  active        Boolean  @default(true)
  rateType      RateType @default(BUY_SELL)
  buyRate       String?
  sellRate      String?
  singleRate    String?
  bulkRate      String?
  description   String?
  imageUrl      String?
  manualNote    String?
  marginPercent Float    @default(0)
  showInSlider  Boolean  @default(false)
  updatedAt     DateTime @updatedAt
  createdAt     DateTime @default(now())

  @@index([createdAt(sort: Desc)])
  @@index([active, priority])
  @@index([symbol])
}

model RateList {
  id        String   @id @default(cuid())
  title     String
  rates     Json
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive, createdAt(sort: Desc)])
}

model PageView {
  id        String   @id @default(cuid())
  page      String
  views     Int
  date      DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([page, date])
  @@index([date])
}

model Newsletter {
  id        String   @id @default(cuid())
  email     String   @unique
  isActive  Boolean  @default(true)
  userId    String?  @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User?    @relation(fields: [userId], references: [id])
}

model SystemSettings {
  id              String   @id @default(cuid())
  siteName        String?
  siteDescription String?
  logoUrl         String?
  maintenanceMode Boolean  @default(false)
  cacheEnabled    Boolean  @default(true)
  smtpServer      String?
  smtpPort        String?
  smtpUsername    String?
  smtpPassword    String?
  telegram        String?
  instagram       String?
  whatsapp        String?
  twitter         String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model SystemLog {
  id        String   @id @default(cuid())
  level     String
  message   String
  source    String
  timestamp DateTime @default(now())

  @@index([timestamp])
}

model ActivityLog {
  id        String   @id @default(cuid())
  userId    String
  action    String
  details   String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
}

model Activity {
  id        String   @id @default(cuid())
  userId    String
  action    String
  details   String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])

  @@index([userId])
}

model CurrencyPattern {
  id        String   @id @default(cuid())
  type      String
  pattern   String
  value     Float?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([type, pattern])
}

model SocialLink {
  id         String         @id @default(cuid())
  name       String
  url        String
  icon       String?
  iconWidth  Int?
  iconHeight Int?
  color      String?
  order      Int            @default(0)
  isActive   Boolean        @default(true)
  type       SocialLinkType @default(SOCIAL)
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  @@index([type, isActive, order])
}

model ServiceRequest {
  id                    String                    @id @default(cuid())
  trackingCode          String                    @unique
  fullName              String
  phone                 String
  email                 String?
  serviceType           ServiceType
  amount                String
  currency              String
  description           String?
  urgency               RequestUrgency            @default(NORMAL)
  contactMethod         String
  status                ServiceRequestStatus      @default(PENDING)
  adminNotes            String?
  ipAddress             String?
  userAgent             String?
  createdAt             DateTime                  @default(now())
  updatedAt             DateTime                  @updatedAt
  userId                String?
  metadata              Json?
  estimatedCompletionAt DateTime?
  externalTxId          String?
  phoneVerified         Boolean                   @default(false)
  emailVerified         Boolean                   @default(false)
  idempotencyKey        String?                   @unique
  user                  User?                       @relation(fields: [userId], references: [id])
  statusLogs            ServiceRequestStatusLog[]
  notes                 ServiceRequestNote[]
  attachments           ServiceRequestAttachment[]

  @@index([trackingCode])
  @@index([phone])
  @@index([status])
  @@index([createdAt])
  @@index([userId])
  @@index([idempotencyKey])
  @@index([phone, amount, currency, createdAt])
  @@index([status, createdAt(sort: Desc)])
}

model ServiceRequestStatusLog {
  id         String         @id @default(cuid())
  requestId  String
  fromStatus String?
  toStatus   String
  changedBy  String
  note       String?
  createdAt  DateTime       @default(now())
  request    ServiceRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([requestId, createdAt(sort: Desc)])
}

/// 2026-07-09: یادداشت داخلی ادمین/پشتیبانی روی هر درخواست خدمات.
/// غیرقابل ویرایش پس از ثبت (append-only) — برای جلوگیری از دستکاری مدارک.
model ServiceRequestNote {
  id        String         @id @default(cuid())
  requestId String
  authorId  String
  body      String
  content   String?
  isPrivate Boolean        @default(true)
  createdAt DateTime       @default(now())
  request   ServiceRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([requestId, createdAt(sort: Desc)])
  @@index([authorId])
}

/// 2026-07-09: مدارک پیوست معامله (تصویر رسید، اسکن فاکتور و غیره).
/// url: آدرس ذخیره‌شده در storage (UploadThing / local).
/// fileHash: SHA-256 محتوا برای تشخیص دستکاری.
model ServiceRequestAttachment {
  id           String         @id @default(cuid())
  requestId    String
  uploadedById String
  fileName     String
  fileType     String
  fileSize     Int
  url          String
  fileHash     String?
  label        String?
  createdAt    DateTime       @default(now())
  request      ServiceRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([requestId, createdAt(sort: Desc)])
  @@index([uploadedById])
}

/// 2026-06-14: تبلیغ باریک بالای هدر.
/// فقط یک ردیف فعال در لحظه (singleton).
/// کاربر می‌تواند با دکمه × آن را برای session ببندد
/// (کوکی client-side — در سرور نگه‌داری نمی‌شود).
model HeaderAd {
  id        String          @id @default(cuid())
  text      String
  subtext   String?
  ctaLabel  String?
  ctaHref   String?
  imageUrl  String?
  href      String?
  variant   HeaderAdVariant @default(TEXT)
  theme     HeaderAdTheme   @default(PRIMARY)
  isActive  Boolean         @default(false)
  priority  Int             @default(0)
  startDate DateTime?
  endDate   DateTime?
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  @@index([isActive, startDate, endDate])
  @@index([priority])
}

model Task {
  id          String       @id @default(cuid())
  title       String
  description String?
  status      TaskStatus   @default(PENDING)
  priority    TaskPriority @default(MEDIUM)
  dueDate     DateTime?
  userId      String
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  user        User         @relation(fields: [userId], references: [id])

  @@index([userId, status, createdAt(sort: Desc)])
  @@index([userId, dueDate])
  @@index([status, dueDate])
}

model TransferProvider {
  id            String    @id @default(cuid())
  slug          String    @unique
  name          String
  kind          TransferKind
  spreadPercent Float     @default(0)
  flatFeeToman  Int       @default(0)
  speedMinutes  Int       @default(0)
  features      String[]  @default([])
  active        Boolean   @default(true)
  order         Int       @default(100)
  description   String?
  logoUrl       String?
  /// اگر این provider متعلق به یک صرافی خاص باشد — null = پلتفرم‌شمول
  exchangeId    String?
  Exchange      Exchange? @relation(fields: [exchangeId], references: [id], onDelete: Cascade)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([active, order])
  @@index([exchangeId])
}

model AuditLog {
  id         String    @id
  exchangeId String?
  actorId    String?
  actorRole  String?
  action     String
  entityType String?
  entityId   String?
  ip         String?
  deviceId   String?
  beforeHash String?
  afterHash  String?
  meta       Json?
  createdAt  DateTime  @default(now())
  Exchange   Exchange? @relation(fields: [exchangeId], references: [id], onDelete: Cascade)

  @@index([action])
  @@index([actorId])
  @@index([createdAt(sort: Desc)])
  @@index([entityType, entityId])
  @@index([exchangeId])
}

model Beneficiary {
  id         String   @id
  userId     String
  name       String
  identifier String
  note       String?
  createdAt  DateTime @default(now())
  User       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, identifier])
  @@index([userId, createdAt])
}

model BillingAddress {
  id            String   @id
  userId        String   @unique
  country       String   @default("af")
  province      String?
  city          String?
  address       String?
  postalCode    String?
  recipientName String?
  phoneNumber   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime
  User          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ContactSubmission {
  id        String   @id
  name      String
  email     String
  subject   String?
  message   String
  userId    String?
  status    String   @default("NEW")
  ipAddress String?
  createdAt DateTime @default(now())
  updatedAt DateTime

  @@index([createdAt(sort: Desc)])
  @@index([status])
}

model Customer {
  id              String            @id
  exchangeId      String
  userId          String?           @unique
  fullName        String
  fatherName      String?
  nationalId      String?
  passportNo      String?
  phone           String
  email           String?
  address         String?
  city            String?
  status          CustomerStatus    @default(PROSPECT)
  kycLevel        KycLevel          @default(NONE)
  kycStatus       KycStatus         @default(NOT_STARTED)
  personalLimitAf BigInt?
  riskScore       Int               @default(0)
  notes           String?
  createdById     String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime
  Exchange        Exchange          @relation(fields: [exchangeId], references: [id], onDelete: Cascade)
  User            User?             @relation(fields: [userId], references: [id])
  Device          Device[]
  FintechAccount  FintechAccount[]
  FraudReview     FraudReview[]
  KycVerification KycVerification[]
  LedgerEntry     LedgerEntry[]
  Transaction     Transaction[]
  Wallet          Wallet[]

  @@index([createdAt(sort: Desc)])
  @@index([exchangeId])
  @@index([exchangeId, status])
  @@index([kycStatus])
  @@index([nationalId])
  @@index([phone])
}

model Device {
  id          String       @id
  exchangeId  String?
  userId      String?
  customerId  String?
  fingerprint String
  userAgent   String?
  ip          String?
  status      DeviceStatus @default(UNVERIFIED)
  lastSeenAt  DateTime     @default(now())
  createdAt   DateTime     @default(now())
  Customer    Customer?    @relation(fields: [customerId], references: [id], onDelete: Cascade)
  Exchange    Exchange?    @relation(fields: [exchangeId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@index([exchangeId])
  @@index([fingerprint])
  @@index([userId])
}

model Exchange {
  id              String            @id
  name            String
  slug            String            @unique
  licenseNo       String?
  city            String?
  address         String?
  phone           String?
  email           String?
  logoUrl         String?
  status          ExchangeStatus    @default(PENDING)
  dailyLimitAf    BigInt            @default(0)
  platformFee     Float             @default(0)
  requireKyc      Boolean           @default(true)
  createdById     String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime
  AuditLog         AuditLog[]
  Customer         Customer[]
  Device           Device[]
  ExchangeStaff    ExchangeStaff[]
  FintechAccount   FintechAccount[]
  FraudReview      FraudReview[]
  KycVerification  KycVerification[]
  LedgerEntry      LedgerEntry[]
  Transaction      Transaction[]
  TransferProvider TransferProvider[]
  Wallet           Wallet[]

  @@index([city])
  @@index([createdAt(sort: Desc)])
  @@index([slug])
  @@index([status])
}

model ExchangeStaff {
  id          String            @id
  exchangeId  String
  userId      String
  role        ExchangeStaffRole @default(STAFF)
  title       String?
  permissions String[]          @default([])
  invitedBy   String?
  joinedAt    DateTime          @default(now())
  revokedAt   DateTime?
  Exchange    Exchange          @relation(fields: [exchangeId], references: [id], onDelete: Cascade)
  User        User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([exchangeId, userId])
  @@index([exchangeId])
  @@index([role])
  @@index([userId])
}

model FintechAccount {
  id          String        @id
  exchangeId  String
  customerId  String
  type        AccountType   @default(WALLET)
  label       String?
  currency    String        @default("AFN")
  status      AccountStatus @default(PENDING)
  balance     BigInt        @default(0)
  frozenUntil DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime
  Customer    Customer      @relation(fields: [customerId], references: [id], onDelete: Cascade)
  Exchange    Exchange      @relation(fields: [exchangeId], references: [id], onDelete: Cascade)
  LedgerEntry LedgerEntry[]
  Transaction Transaction[]
  Wallet      Wallet?

  @@index([customerId])
  @@index([customerId, status])
  @@index([exchangeId])
  @@index([type, status])
}

model FraudReview {
  id           String       @id
  exchangeId   String
  txnId        String?
  customerId   String?
  reason       String
  riskScore    Int          @default(0)
  status       String       @default("OPEN")
  assignedToId String?
  resolution   String?
  createdAt    DateTime     @default(now())
  resolvedAt   DateTime?
  Customer     Customer?    @relation(fields: [customerId], references: [id])
  Exchange     Exchange     @relation(fields: [exchangeId], references: [id], onDelete: Cascade)
  Transaction  Transaction? @relation(fields: [txnId], references: [id])

  @@index([exchangeId, status])
  @@index([riskScore])
  @@index([status])
}

model KycAttempt {
  id             String           @id
  userId         String
  step           Int              @default(1)
  status         KycAttemptStatus @default(STARTED)
  nationalIdHash String?
  phoneVerified  Boolean          @default(false)
  docUrl         String?
  selfieUrl      String?
  rejectReason   String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime
}

model KycRecord {
  id             String    @id
  userId         String    @unique
  fullName       String?
  nationalIdHash String?   @unique
  selfieUrl      String?
  docFrontUrl    String?
  docBackUrl     String?
  rejectedReason String?
  submittedAt    DateTime?
  reviewedAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime
  User           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model KycVerification {
  id            String    @id
  exchangeId    String
  customerId    String
  level         KycLevel  @default(LEVEL_1)
  status        KycStatus @default(PENDING)
  docType       String
  docNumber     String?
  fileUrl       String?
  fileHash      String?
  encryptedData String?
  reviewedById  String?
  reviewedAt    DateTime?
  rejectReason  String?
  expiresAt     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime
  Customer      Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  Exchange      Exchange  @relation(fields: [exchangeId], references: [id], onDelete: Cascade)

  @@index([customerId, level])
  @@index([customerId, status])
  @@index([exchangeId])
  @@index([status])
}

model LedgerEntry {
  id             String          @id
  exchangeId     String
  accountId      String
  customerId     String
  txnId          String?
  direction      LedgerDirection
  amount         BigInt
  currency       String          @default("AFN")
  runningBalance BigInt
  description    String?
  createdById    String?
  createdAt      DateTime        @default(now())
  FintechAccount FintechAccount  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  Customer       Customer        @relation(fields: [customerId], references: [id], onDelete: Cascade)
  Exchange       Exchange        @relation(fields: [exchangeId], references: [id], onDelete: Cascade)
  Transaction    Transaction?    @relation(fields: [txnId], references: [id])

  @@index([accountId, createdAt(sort: Desc)])
  @@index([customerId, createdAt(sort: Desc)])
  @@index([exchangeId])
  @@index([txnId])
}

model Permission {
  id          String   @id
  key         String
  description String?
  createdAt   DateTime @default(now())
}

model RolePermission {
  id           String   @id
  role         Role
  permissionId String
  createdAt    DateTime @default(now())
}

model Transaction {
  id             String            @id
  exchangeId     String
  customerId     String
  accountId      String
  kind           TransactionKind
  status         TransactionStatus @default(PENDING)
  amount         BigInt
  currency       String            @default("AFN")
  rate           Float?
  fee            BigInt            @default(0)
  destAmount     BigInt?
  destCurrency   String?
  idempotencyKey String?           @unique
  externalRef    String?
  counterparty   String?
  note           String?
  meta           Json?
  createdById    String?
  reviewedById   String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime
  FraudReview    FraudReview[]
  LedgerEntry    LedgerEntry[]
  FintechAccount FintechAccount    @relation(fields: [accountId], references: [id], onDelete: Cascade)
  Customer       Customer          @relation(fields: [customerId], references: [id], onDelete: Cascade)
  Exchange       Exchange          @relation(fields: [exchangeId], references: [id], onDelete: Cascade)

  @@index([accountId, createdAt(sort: Desc)])
  @@index([createdAt(sort: Desc)])
  @@index([customerId, createdAt(sort: Desc)])
  @@index([exchangeId])
  @@index([kind, status])
  @@index([status])
}

model TwoFactorBackupCode {
  id        String    @id
  userId    String
  codeHash  String
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  User      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VirtualCard {
  id        String         @id
  walletId  String
  userId    String
  label     String?
  last4     String
  brand     String         @default("VISA")
  status    CardStatus     @default(ACTIVE)
  balance   BigInt         @default(0)
  currency  WalletCurrency @default(USD)
  expiresAt DateTime
  createdAt DateTime       @default(now())
  updatedAt DateTime
  User      User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([walletId])
}

model Wallet {
  id             String         @id
  exchangeId     String
  customerId     String
  accountId      String         @unique
  currency       String         @default("AFN")
  balance        BigInt         @default(0)
  locked         BigInt         @default(0)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime
  FintechAccount FintechAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  Customer       Customer       @relation(fields: [customerId], references: [id], onDelete: Cascade)
  Exchange       Exchange       @relation(fields: [exchangeId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@index([exchangeId])
}

