// ─────────────────────────────────────────────────────────────────────────────
// ExchangeRateQuote — قیمت‌گذاری صرافی برای هر ارز (ثبت، تایید، نمایش)
// ─────────────────────────────────────────────────────────────────────────────

/// وضعیت یک quote قیمت‌گذاری صرافی
enum QuoteStatus {
  PENDING   // ثبت‌شده — در انتظار تایید ادمین
  ACTIVE    // تایید‌شده — در سایت نمایش داده می‌شود
  REJECTED  // رد‌شده توسط ادمین با یادداشت
  EXPIRED   // منقضی‌شده (cron خودکار)
  ARCHIVED  // آرشیو دستی توسط ادمین
  LOCKED    // انتخاب‌شده توسط مشتری — در حین انجام معامله
}

/// نحوه انجام معامله
enum DealChannel {
  ONLINE    // از طریق پلتفرم
  INPERSON  // حضوری در شعبه صرافی
  PHONE     // تلفنی
}

/// وضعیت معامله
enum DealStatus {
  PENDING     // ثبت‌شده — در انتظار تایید صرافی
  CONFIRMED   // تایید صرافی
  PROCESSING  // در حال انجام
  COMPLETED   // تکمیل‌شده
  CANCELLED   // لغو‌شده
  DISPUTED    // در حال رسیدگی به اعتراض
  REFUNDED    // بازگشت وجه
}

/// قیمت ثبت‌شده توسط صرافی برای یک ارز — پس از تایید ادمین در سایت نمایش داده می‌شود
model ExchangeRateQuote {
  id              String       @id @default(cuid())
  exchangeId      String
  /// کد ارز استاندارد ISO 4217
  currencyCode    String       // USD، EUR، AFN، AED، …
  /// جفت ارز: "USD/AFN"، "USD/IRR"، "EUR/AFN"
  currencyPair    String
  /// قیمت خرید صرافی (صرافی از مشتری می‌خرد) — واحد: تومان یا افغانی
  buyRate         Decimal      @db.Decimal(20, 6)
  /// قیمت فروش صرافی (صرافی به مشتری می‌فروشد)
  sellRate        Decimal      @db.Decimal(20, 6)
  /// واحد پول پایه: toman / rial / afn / usd
  unit            String       @default("toman")
  /// حداقل مبلغ معامله
  minAmount       Decimal?     @db.Decimal(20, 2)
  /// حداکثر مبلغ معامله
  maxAmount       Decimal?     @db.Decimal(20, 2)
  status          QuoteStatus  @default(PENDING)
  /// مدت اعتبار (دقیقه) — از approvedAt محاسبه می‌شود
  validMinutes    Int          @default(60)
  /// زمان انقضا (پر می‌شود هنگام ACTIVE شدن)
  expiresAt       DateTime?
  /// یادداشت ادمین هنگام تایید یا رد
  note            String?
  /// شناسه ادمین تایید‌کننده
  approvedById    String?
  approvedAt      DateTime?
  /// شناسه صراف ثبت‌کننده
  submittedById   String?
  /// شماره نسخه برای optimistic locking
  version         Int          @default(1)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  Exchange    Exchange          @relation(fields: [exchangeId], references: [id], onDelete: Cascade)
  StatusLogs  QuoteStatusLog[]
  Deals       CurrencyDeal[]

  @@index([exchangeId, currencyCode, status])
  @@index([status, expiresAt])
  @@index([exchangeId, status])
  @@index([approvedById])
  @@index([currencyCode, status])
}

/// تاریخچه کامل تغییر وضعیت هر quote — برای audit trail و نمودار تاریخچه نرخ
model QuoteStatusLog {
  id         String      @id @default(cuid())
  quoteId    String
  fromStatus QuoteStatus?
  toStatus   QuoteStatus
  actorId    String?
  /// نقش انجام‌دهنده: ADMIN / SARAFI / SYSTEM (cron)
  actorRole  String?
  /// دلیل رد یا انقضا
  reason     String?
  /// metadata: اختلاف با بازار٪، buyRate قبلی و جدید
  metadata   Json?
  createdAt  DateTime    @default(now())

  Quote ExchangeRateQuote @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  @@index([quoteId, createdAt(sort: Desc)])
  @@index([actorId])
}

// ─────────────────────────────────────────────────────────────────────────────
// CurrencyDeal — معامله ارزی (آنلاین یا حضوری)
// مشتری یک quote را انتخاب می‌کند و یک معامله ثبت می‌شود
// ─────────────────────────────────────────────────────────────────────────────

model CurrencyDeal {
  id             String      @id @default(cuid())
  /// کد پیگیری منحصربه‌فرد برای مشتری
  trackingCode   String      @unique
  exchangeId     String
  /// quote ای که مشتری بر اساس آن معامله کرده
  quoteId        String?
  /// شناسه کاربر ثبت‌نام‌شده (null = مشتری مهمان)
  userId         String?
  /// اطلاعات تماس (برای مشتری مهمان یا حضوری)
  customerName   String
  customerPhone  String
  customerEmail  String?
  /// کد ارز مبدأ
  fromCurrency   String      // USD، EUR، …
  /// کد ارز مقصد
  toCurrency     String      // AFN، IRR، AED، …
  /// مبلغ پرداختی مشتری — #6 fix: Decimal(20,6) برای دقت بهتر مبالغ ارزی
  fromAmount     Decimal     @db.Decimal(20, 6)
  /// مبلغ دریافتی مشتری (محاسبه‌شده)
  toAmount       Decimal     @db.Decimal(20, 6)
  /// نرخ اعمال‌شده در معامله — نرخ‌ها نیاز به دقت بیشتر دارند: Decimal(20,6)
  appliedRate    Decimal     @db.Decimal(20, 6)
  /// کارمزد صرافی
  feeAmount      Decimal     @default(0) @db.Decimal(20, 6)
  /// نرخ مرجع بازار در زمان معامله (برای سابقه) — نرخ‌ها: Decimal(20,6)
  marketRateRef  Decimal?    @db.Decimal(20, 6)
  channel        DealChannel @default(ONLINE)
  status         DealStatus  @default(PENDING)
  /// یادداشت مشتری
  note           String?
  /// یادداشت داخلی صرافی (private)
  internalNote   String?
  /// idempotency برای جلوگیری از ثبت تکراری
  idempotencyKey String?     @unique
  /// شناسه کارمند صرافی که معامله را تایید کرد
  confirmedById  String?
  confirmedAt    DateTime?
  /// زمان تکمیل معامله
  completedAt    DateTime?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  Exchange    Exchange           @relation(fields: [exchangeId], references: [id], onDelete: Cascade)
  Quote       ExchangeRateQuote? @relation(fields: [quoteId], references: [id], onDelete: SetNull)
  User        User?              @relation(fields: [userId], references: [id], onDelete: SetNull)
  StatusLogs  DealStatusLog[]
  Attachments DealAttachment[]

  @@index([exchangeId, status, createdAt(sort: Desc)])
  @@index([trackingCode])
  @@index([userId, createdAt(sort: Desc)])
  @@index([customerPhone])
  @@index([status, createdAt(sort: Desc)])
  @@index([idempotencyKey])
  @@index([quoteId])
}

/// تاریخچه وضعیت معامله
model DealStatusLog {
  id         String     @id @default(cuid())
  dealId     String
  fromStatus DealStatus?
  toStatus   DealStatus
  actorId    String?
  actorRole  String?
  note       String?
  createdAt  DateTime   @default(now())

  Deal CurrencyDeal @relation(fields: [dealId], references: [id], onDelete: Cascade)

  @@index([dealId, createdAt(sort: Desc)])
}

/// مدارک و رسید معامله
model DealAttachment {
  id           String   @id @default(cuid())
  dealId       String
  uploadedById String
  fileName     String
  fileType     String
  fileSize     Int
  url          String
  fileHash     String?
  /// نوع سند: RECEIPT / ID_SCAN / CONTRACT / OTHER
  label        String?
  createdAt    DateTime @default(now())

  Deal CurrencyDeal @relation(fields: [dealId], references: [id], onDelete: Cascade)

  @@index([dealId])
  @@index([uploadedById])
}

// ─────────────────────────────────────────────────────────────────────────────
// Settlement — تسویه بین صرافی و پلتفرم
// ─────────────────────────────────────────────────────────────────────────────

model Settlement {
  id            String           @id @default(cuid())
  exchangeId    String
  /// دوره محاسبه (شروع)
  periodStart   DateTime
  /// دوره محاسبه (پایان)
  periodEnd     DateTime
  /// مجموع حجم معاملات در این دوره (smallest unit)
  totalVolume   BigInt           @default(0)
  /// تعداد معاملات
  dealCount     Int              @default(0)
  /// کارمزد پلتفرم (محاسبه‌شده از platformFee Exchange)
  platformFee   BigInt           @default(0)
  /// خالص قابل پرداخت به صرافی
  exchangeNet   BigInt           @default(0)
  /// ارز پایه محاسبه
  currency      String           @default("AFN")
  status        SettlementStatus @default(PENDING)
  /// یادداشت ادمین
  note          String?
  /// شناسه ادمین تأییدکننده
  approvedById  String?
  approvedAt    DateTime?
  /// زمان پرداخت
  paidAt        DateTime?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  Exchange      Exchange         @relation(fields: [exchangeId], references: [id], onDelete: Cascade)

  @@index([exchangeId, status])
  @@index([periodStart, periodEnd])
  @@index([status])
}



// ─────────────────────────────────────────────────────────────────────────────
// TransactionOtp — کد یکبار مصرف برای تأیید تراکنش‌های حساس
// ─────────────────────────────────────────────────────────────────────────────

model TransactionOtp {
  id        String   @id @default(cuid())
  userId    String
  txnRef    String
  otpHash   String
  used      Boolean  @default(false)
  expiresAt DateTime
  createdAt DateTime @default(now())
  User      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, txnRef])
  @@index([userId, expiresAt])
  @@index([expiresAt])
}

