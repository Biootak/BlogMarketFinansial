generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "windows", "debian-openssl-3.0.x", "rhel-openssl-3.0.x", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                  String                @id @default(cuid())
  name                String?
  email               String                @unique
  role                Role                  @default(USER)
  status              String                @default("Active")
  password            String?
  emailVerified       DateTime?
  phoneNumber         String?
  image               String?
  imageWidth          Int?
  imageHeight         Int?
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
  nationalIdHash      String?
  kycSubmittedAt      DateTime?
  kycReviewedAt       DateTime?
  kycRejectReason     String?
  kycDocUrl           String?
  twoFactorEnabled    Boolean               @default(false)
  twoFactorSecret     String?
  twoFactorSecretEnc  String?
  exchangePartnerId   String?
  tokenVersion        Int                   @default(0)
  accounts            Account[]
  activities          ActivityLog[]
  Beneficiary         Beneficiary[]
  BillingAddress      BillingAddress?
  comments            Comment[]
  Customer            Customer?
  ExchangeStaff       ExchangeStaff[]
  KycRecord           KycRecord?
  likes               Like[]
  newsletter          Newsletter?
  notifications       Notification[]
  posts               Post[]
  profile             Profile?
  savedPosts          SavedPost[]
  serviceRequests     ServiceRequest[]
  sessions            Session[]
  tasks               Task[]
  TwoFactorBackupCode TwoFactorBackupCode[]
  VirtualCard         VirtualCard[]
  CurrencyDeal        CurrencyDeal[]
  TransactionOtp      TransactionOtp[]
  Device              Device[]
  ApiKeys             ApiKey[]
  Webhooks            Webhook[]

  @@index([status])
  @@index([role, status])
  @@index([phoneNumber])
  @@index([exchangePartnerId])
}

model Account {
  id                String   @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime
  deviceId     String?
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([deviceId])
}

model VerificationToken {
  id       String   @id @default(cuid())
  email    String
  token    String   @unique
  expires  DateTime
  attempts Int      @default(0)
  intent   String   @default("register")

  @@unique([email, intent])
  @@unique([email, token])
  @@index([email])
  @@index([expires])
}

model Profile {
  id            String  @id @default(cuid())
  bio           String?
  avatar        String?
  bgImage       String?
  avatarWidth   Int?
  avatarHeight  Int?
  bgImageWidth  Int?
  bgImageHeight Int?
  jobName       String?
  company       String?
  userId        String  @unique
  user          User    @relation(fields: [userId], references: [id])
}

model Post {
  id                  String      @id @default(cuid())
  title               String
  content             String
  excerpt             String?
  slug                String      @unique
  isFeatured          Boolean     @default(false)
  status              PostStatus  @default(DRAFT)
  featuredImage       String?
  featuredImageWidth  Int?
  featuredImageHeight Int?
  galleryImages       String[]    @default([])
  postType            PostType    @default(STANDARD)
  videoUrl            String?
  audioUrl            String?
  authorId            String
  viewCount           Int         @default(0)
  readingTime         Int         @default(0)
  scheduledAt         DateTime?
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt
  comments            Comment[]
  likes               Like[]
  author              User        @relation(fields: [authorId], references: [id])
  savedBy             SavedPost[]
  views               View[]
  categories          Category[]  @relation("CategoryToPost")
  tags                Tag[]       @relation("PostToTag")

  @@index([status])
  @@index([authorId])
  @@index([createdAt])
  @@index([isFeatured])
  @@index([scheduledAt])
  @@index([status, createdAt(sort: Desc)])
  @@index([status, viewCount(sort: Desc)])
  @@index([status, isFeatured, createdAt(sort: Desc)])
  @@index([authorId, status, createdAt(sort: Desc)])
  @@index([title])
}

model View {
  id        String   @id @default(cuid())
  postId    String
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  post      Post     @relation(fields: [postId], references: [id])

  @@index([postId])
  @@index([createdAt])
}

model Comment {
  id        String    @id @default(cuid())
  content   String
  postId    String
  authorId  String
  parentId  String?
  approved  Boolean   @default(false)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  author    User      @relation(fields: [authorId], references: [id])
  parent    Comment?  @relation("CommentToComment", fields: [parentId], references: [id])
  replies   Comment[] @relation("CommentToComment")
  post      Post      @relation(fields: [postId], references: [id])
  likes     Like[]

  @@index([postId])
  @@index([authorId])
  @@index([approved])
  @@index([postId, approved, createdAt(sort: Desc)])
  @@index([authorId, createdAt(sort: Desc)])
}

model Like {
  id        String   @id @default(cuid())
  userId    String
  postId    String?
  commentId String?
  createdAt DateTime @default(now())
  comment   Comment? @relation(fields: [commentId], references: [id])
  post      Post?    @relation(fields: [postId], references: [id])
  user      User     @relation(fields: [userId], references: [id])

  @@unique([userId, postId])
  @@unique([userId, commentId])
  @@index([postId, createdAt(sort: Desc)])
  @@index([commentId, createdAt(sort: Desc)])
  @@index([userId, createdAt(sort: Desc)])
}

model Category {
  id               String     @id @default(cuid())
  name             String
  slug             String     @unique
  thumbnail        String?
  thumbnailWidth   Int?
  thumbnailHeight  Int?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
  childCategories  Category[] @relation("CategoryToParent")
  parentCategories Category[] @relation("CategoryToParent")
  posts            Post[]     @relation("CategoryToPost")
}

model Tag {
  id              String   @id @default(cuid())
  name            String   @unique
  slug            String   @unique
  thumbnail       String?
  thumbnailWidth  Int?
  thumbnailHeight Int?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  posts           Post[]   @relation("PostToTag")
}

model SavedPost {
  id        String   @id @default(cuid())
  userId    String
  postId    String
  createdAt DateTime @default(now())
  post      Post     @relation(fields: [postId], references: [id])
  user      User     @relation(fields: [userId], references: [id])

  @@unique([userId, postId])
  @@index([createdAt(sort: Desc)])
  @@index([postId, createdAt(sort: Desc)])
}

model Notification {
  id        Int      @id @default(autoincrement())
  message   String
  userId    String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])

  @@index([createdAt])
  @@index([userId, createdAt(sort: Desc)])
  @@index([userId, isRead])
}

model Advertisement {
  id               String     @id @default(cuid())
  title            String
  description      String?
  imageUrl         String
  linkUrl          String
  startDate        DateTime
  endDate          DateTime
  isActive         Boolean    @default(true)
  size             AdSize     @default(MEDIUM)
  position         AdPosition @default(IN_CONTENT)
  customPosition   String?
  order            Int        @default(0)
  customDimensions Json?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  @@index([isActive, startDate, endDate])
  @@index([position, order])
}

model ExchangeRate {
  id            String   @id @default(cuid())
  name          String   @unique
  currency      String
  symbol        String?  @unique
  displayNameFa String?
  group         String?
  unit          String?
  divisor       Int      @default(1)
  decimals      Int      @default(0)
  priority      Int      @default(99)
  provider      String   @default("auto")
  tgjuKey       String?
  active        Boolean  @default(true)
  rateType      RateType @default(BUY_SELL)
  buyRate       String?
  sellRate      String?
  singleRate    String?
  bulkRate      String?
  description   String?
  imageUrl      String?
  manualNote    String?
  marginPercent Float    @default(0)
  showInSlider  Boolean  @default(false)
  updatedAt     DateTime @updatedAt
  createdAt     DateTime @default(now())

  @@index([createdAt(sort: Desc)])
  @@index([active, priority])
  @@index([symbol])
}

model RateList {
  id        String   @id @default(cuid())
  title     String
  rates     Json
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive, createdAt(sort: Desc)])
}

model PageView {
  id        String   @id @default(cuid())
  page      String
  views     Int
  date      DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([page, date])
  @@index([date])
}

model Newsletter {
  id        String   @id @default(cuid())
  email     String   @unique
  isActive  Boolean  @default(true)
  userId    String?  @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User?    @relation(fields: [userId], references: [id])
}

model SystemSettings {
  id              String   @id @default(cuid())
  siteName        String?
  siteDescription String?
  logoUrl         String?
  maintenanceMode Boolean  @default(false)
  cacheEnabled    Boolean  @default(true)
  smtpServer      String?
  smtpPort        String?
  smtpUsername    String?
  smtpPassword    String?
  telegram        String?
  instagram       String?
  whatsapp        String?
  twitter         String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model SystemLog {
  id        String   @id @default(cuid())
  level     String
  message   String
  source    String
  timestamp DateTime @default(now())

  @@index([timestamp])
}

// #7: Activity و ActivityLog دو مدل تقریباً یکسان بودند.
// Activity را به @deprecated علامت زدیم — داده‌های جدید فقط به ActivityLog می‌روند.
// #8 fix: هر دو @default(cuid()) داشتند — OK است.
model ActivityLog {
  id        String   @id @default(cuid())
  userId    String
  action    String
  details   String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
}

model CurrencyPattern {
  id        String   @id @default(cuid())
  type      String
  pattern   String
  value     Float?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([type, pattern])
}

model SocialLink {
  id         String         @id @default(cuid())
  name       String
  url        String
  icon       String?
  iconWidth  Int?
  iconHeight Int?
  color      String?
  order      Int            @default(0)
  isActive   Boolean        @default(true)
  type       SocialLinkType @default(SOCIAL)
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  @@index([type, isActive, order])
}

model ServiceRequest {
  id                    String                    @id @default(cuid())
  trackingCode          String                    @unique
  fullName              String
  phone                 String
  email                 String?
  serviceType           ServiceType
  amount                String
  currency              String
  description           String?
  urgency               RequestUrgency            @default(NORMAL)
  contactMethod         String
  status                ServiceRequestStatus      @default(PENDING)
  adminNotes            String?
  ipAddress             String?
  userAgent             String?
  createdAt             DateTime                  @default(now())
  updatedAt             DateTime                  @updatedAt
  userId                String?
  /// 2026-07-28: اگر درخواست از صفحه صرافی خاصی ثبت شود، صرافی مقصد اینجاست.
  /// null = درخواست به پلتفرم (flow قدیمی).
  targetExchangeId      String?
  metadata              Json?
  estimatedCompletionAt DateTime?
  externalTxId          String?
  phoneVerified         Boolean                   @default(false)
  emailVerified         Boolean                   @default(false)
  idempotencyKey        String?                   @unique
  user                  User?                       @relation(fields: [userId], references: [id])
  targetExchange        Exchange?                  @relation(fields: [targetExchangeId], references: [id], onDelete: SetNull)
  statusLogs            ServiceRequestStatusLog[]
  notes                 ServiceRequestNote[]
  attachments           ServiceRequestAttachment[]

  @@index([trackingCode])
  @@index([phone])
  @@index([status])
  @@index([createdAt])
  @@index([targetExchangeId, status])
  @@index([targetExchangeId, createdAt(sort: Desc)])
  @@index([userId])
  @@index([idempotencyKey])
  @@index([phone, amount, currency, createdAt])
  @@index([status, createdAt(sort: Desc)])
}

model ServiceRequestStatusLog {
  id         String         @id @default(cuid())
  requestId  String
  fromStatus String?
  toStatus   String
  changedBy  String
  note       String?
  createdAt  DateTime       @default(now())
  request    ServiceRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([requestId, createdAt(sort: Desc)])
}

/// 2026-07-09: یادداشت داخلی ادمین/پشتیبانی روی هر درخواست خدمات.
/// غیرقابل ویرایش پس از ثبت (append-only) — برای جلوگیری از دستکاری مدارک.
model ServiceRequestNote {
  id        String         @id @default(cuid())
  requestId String
  authorId  String
  body      String
  content   String?
  isPrivate Boolean        @default(true)
  createdAt DateTime       @default(now())
  request   ServiceRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([requestId, createdAt(sort: Desc)])
  @@index([authorId])
}

/// 2026-07-09: مدارک پیوست معامله (تصویر رسید، اسکن فاکتور و غیره).
/// url: آدرس ذخیره‌شده در storage (UploadThing / local).
/// fileHash: SHA-256 محتوا برای تشخیص دستکاری.
model ServiceRequestAttachment {
  id           String         @id @default(cuid())
  requestId    String
  uploadedById String
  fileName     String
  fileType     String
  fileSize     Int
  url          String
  fileHash     String?
  label        String?
  createdAt    DateTime       @default(now())
  request      ServiceRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([requestId, createdAt(sort: Desc)])
  @@index([uploadedById])
}

/// 2026-06-14: تبلیغ باریک بالای هدر.
/// فقط یک ردیف فعال در لحظه (singleton).
/// کاربر می‌تواند با دکمه × آن را برای session ببندد
/// (کوکی client-side — در سرور نگه‌داری نمی‌شود).
model HeaderAd {
  id        String          @id @default(cuid())
  text      String
  subtext   String?
  ctaLabel  String?
  ctaHref   String?
  imageUrl  String?
  href      String?
  variant   HeaderAdVariant @default(TEXT)
  theme     HeaderAdTheme   @default(PRIMARY)
  isActive  Boolean         @default(false)
  priority  Int             @default(0)
  startDate DateTime?
  endDate   DateTime?
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  @@index([isActive, startDate, endDate])
  @@index([priority])
}

model Task {
  id          String       @id @default(cuid())
  title       String
  description String?
  status      TaskStatus   @default(PENDING)
  priority    TaskPriority @default(MEDIUM)
  dueDate     DateTime?
  userId      String
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  user        User         @relation(fields: [userId], references: [id])

  @@index([userId, status, createdAt(sort: Desc)])
  @@index([userId, dueDate])
  @@index([status, dueDate])
}

model TransferProvider {
  id            String    @id @default(cuid())
  slug          String    @unique
  name          String
  kind          TransferKind
  spreadPercent Float     @default(0)
  flatFeeToman  Int       @default(0)
  speedMinutes  Int       @default(0)
  features      String[]  @default([])
  active        Boolean   @default(true)
  order         Int       @default(100)
  description   String?
  logoUrl       String?
  /// اگر این provider متعلق به یک صرافی خاص باشد — null = پلتفرم‌شمول
  exchangeId    String?
  Exchange      Exchange? @relation(fields: [exchangeId], references: [id], onDelete: Cascade)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([active, order])
  @@index([exchangeId])
}

/// H6: @default(cuid()) اضافه شد — قبلاً فراموش شده بود
model AuditLog {
  id         String    @id @default(cuid())
  exchangeId String?
  actorId    String?
  actorRole  String?
  action     String
  entityType String?
  entityId   String?
  ip         String?
  deviceId   String?
  beforeHash String?
  afterHash  String?
  meta       Json?
  createdAt  DateTime  @default(now())
  Exchange   Exchange? @relation(fields: [exchangeId], references: [id], onDelete: Cascade)

  @@index([action])
  @@index([actorId])
  @@index([createdAt(sort: Desc)])
  @@index([entityType, entityId])
  @@index([exchangeId])
}

model Beneficiary {
  id         String   @id
  userId     String
  name       String
  identifier String
  note       String?
  createdAt  DateTime @default(now())
  User       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, identifier])
  @@index([userId, createdAt])
}

model BillingAddress {
  id            String   @id
  userId        String   @unique
  country       String   @default("af")
  province      String?
  city          String?
  address       String?
  postalCode    String?
  recipientName String?
  phoneNumber   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime
  User          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// تاریخچه رویدادهای اشتراک کاربر (ارتقاء، تنزل، تمدید، لغو)
/// رابطه فقط از این سمت — User رابطه معکوس ندارد
model SubscriptionEvent {
  id            String    @id
  userId        String
  /// نوع رویداد: UPGRADE | DOWNGRADE | RENEWAL | CANCEL | TRIAL_START
  kind          String
  /// پلن مبدأ (null برای اولین ارتقاء)
  fromPlan      String?
  /// پلن مقصد
  toPlan        String
  /// مبلغ پرداخت‌شده (واحد: صدم ارز — برای AFN: 1 = 1 AFN)
  amount        BigInt    @default(0)
  /// واحد پول: AFN, IRR, USD
  currency      String    @default("AFN")
  /// شماره فاکتور
  invoiceNo     String?   @unique
  /// وضعیت: PENDING | PAID | FAILED | REFUNDED
  status        String    @default("PENDING")
  /// روش پرداخت
  paymentMethod String?
  meta          Json?
  /// تاریخ انقضای پلن جدید
  validUntil    DateTime?
  createdAt     DateTime  @default(now())

  @@index([userId, createdAt(sort: Desc)])
  @@index([status])
}

model ContactSubmission {
  id        String   @id
  name      String
  email     String
  subject   String?
  message   String
  userId    String?
  status    String   @default("NEW")
  ipAddress String?
  createdAt DateTime @default(now())
  updatedAt DateTime

  @@index([createdAt(sort: Desc)])
  @@index([status])
}

model Customer {
  id              String            @id
  exchangeId      String
  userId          String?           @unique
  fullName        String
  fatherName      String?
  nationalId      String?
  passportNo      String?
  phone           String
  email           String?
  address         String?
  city            String?
  status          CustomerStatus    @default(PROSPECT)
  kycLevel        KycLevel          @default(NONE)
  kycStatus       KycStatus         @default(NOT_STARTED)
  personalLimitAf BigInt?
  riskScore       Int               @default(0)
  notes           String?
  createdById     String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime
  Exchange        Exchange          @relation(fields: [exchangeId], references: [id], onDelete: Cascade)
  User            User?             @relation(fields: [userId], references: [id])
  Device          Device[]
  FintechAccount  FintechAccount[]
  FraudReview     FraudReview[]
  KycVerification KycVerification[]
  LedgerEntry     LedgerEntry[]
  Transaction     Transaction[]
  CustomerRequest CustomerRequest[]

  @@index([createdAt(sort: Desc)])
  @@index([exchangeId])
  @@index([exchangeId, status])
  @@index([kycStatus])
  @@index([nationalId])
  @@index([phone])
}

/// 2026-07-28: درخواست‌های structured مشتری به صرافی.
/// جایگزین «هک notification با prefix [REQUEST:TYPE]» شد.
/// هر درخواست type + payload + status + trackingCode مستقل دارد
/// و timeline کامل از ایجاد تا تأیید/رد/لغو را نگه می‌دارد.
model CustomerRequest {
  id           String                @id @default(cuid())
  /// شماره پیگیری کوتاه برای کاربر (مثلاً REQ-A1B2C3)
  trackingCode String                @unique
  customerId   String
  exchangeId   String
  /// کاربر سازنده (ممکن است admin پلتفرم باشد برای support)
  userId       String
  type         CustomerRequestType
  status       CustomerRequestStatus @default(PENDING)
  /// داده‌های ساختاریافته بر اساس نوع (مثلاً برای ACCOUNT_NEW: currency/type/label)
  payload      Json?
  /// توضیح کاربر
  note         String?
  /// پاسخ ادمین/صرافی به درخواست
  resolution   String?
  /// شناسه staff/exchange که رسیدگی کرده
  reviewedById String?
  reviewedAt   DateTime?
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt

  customer        Customer                    @relation(fields: [customerId], references: [id], onDelete: Cascade)
  exchange        Exchange                    @relation(fields: [exchangeId], references: [id], onDelete: Cascade)
  statusLogs      CustomerRequestStatusLog[]

  @@index([customerId, createdAt(sort: Desc)])
  @@index([customerId, status])
  @@index([exchangeId, status, createdAt(sort: Desc)])
  @@index([status, createdAt(sort: Desc)])
  @@index([type, status])
  @@index([userId])
}

/// تاریخچه تغییر وضعیت — برای timeline و audit
model CustomerRequestStatusLog {
  id         String                  @id @default(cuid())
  requestId  String
  fromStatus CustomerRequestStatus?
  toStatus   CustomerRequestStatus
  actorId    String?
  /// نقش: CUSTOMER | STAFF | SYSTEM
  actorRole  String?
  note       String?
  createdAt  DateTime                @default(now())
  request    CustomerRequest         @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([requestId, createdAt(sort: Desc)])
}

enum CustomerRequestType {
  ACCOUNT_NEW
  ACCOUNT_UNFREEZE
  TRANSFER_INITIATE
  LIMIT_INCREASE
  OTHER
}

enum CustomerRequestStatus {
  PENDING
  IN_REVIEW
  APPROVED
  REJECTED
  CANCELLED
}

