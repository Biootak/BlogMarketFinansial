datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  USER
  AUTHOR
  ADMIN
  SUPER_ADMIN
}

enum PostType {
  STANDARD
  VIDEO
  GALLERY
  AUDIO
}

enum PostStatus {
  DRAFT
  PENDING_REVIEW
  PUBLISHED
}

enum AdSize {
  SMALL
  MEDIUM
  LARGE
  CUSTOM
}

enum AdPosition {
  HEADER
  FOOTER
  SIDEBAR
  IN_CONTENT
  BETWEEN_POSTS
  CUSTOM
}

enum RateType {
  BUY_SELL
  SINGLE_BULK
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  role          Role      @default(USER)
  status        String    @default("Active")
  password      String?
  emailVerified DateTime?
  phoneNumber   String?
  image         String?

  accounts      Account[]
  sessions      Session[]
  posts         Post[]
  comments      Comment[]
  likes         Like[]
  savedPosts    SavedPost[]
  profile       Profile?
  notifications Notification[]
  newsletter    Newsletter[]
  activities    ActivityLog[]
  activity      Activity[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // 2026-06-14: hot paths — system reports filters by status (Active),
  // dashboard user lists filter by role + status, and full-text
  // searches fall back to these without an index. Each one was a
  // seq scan before.
  @@index([status])
  @@index([role, status])
  @@index([phoneNumber])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model VerificationToken {
  id      String   @id @default(cuid())
  email   String
  token   String   @unique
  expires DateTime

  @@unique([email, token])
}

model Profile {
  id      String  @id @default(cuid())
  bio     String?
  avatar  String?
  bgImage String?
  jobName String?
  company String?
  userId  String  @unique
  user    User    @relation(fields: [userId], references: [id])
}

model Post {
  id            String     @id @default(cuid())
  title         String
  content       String
  excerpt       String?
  slug          String     @unique
  isFeatured    Boolean    @default(false)
  status        PostStatus @default(DRAFT)
  featuredImage String?
  galleryImages String[]   @default([])
  postType      PostType   @default(STANDARD)
  videoUrl      String?
  audioUrl      String?
  authorId      String
  viewCount     Int        @default(0)
  readingTime   Int        @default(0)

  author     User        @relation(fields: [authorId], references: [id])
  comments   Comment[]
  categories Category[]
  tags       Tag[]
  likes      Like[]
  savedBy    SavedPost[]
  views      View[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([authorId])
  @@index([createdAt])
  @@index([isFeatured])
  // 2026-06-14: composite indexes for the hot read paths.
  // The archive page + home always filter by status, then sort by
  // createdAt (or likes count) — single-column indexes force the
  // planner to either filter or sort, never both. The (status, createdAt)
  // and (status, viewCount) pairs let Postgres do an index-only scan.
  @@index([status, createdAt(sort: Desc)])
  @@index([status, viewCount(sort: Desc)])
  @@index([status, isFeatured, createdAt(sort: Desc)])
  // For author-scoped listings (e.g. dashboard AUTHOR role).
  @@index([authorId, status, createdAt(sort: Desc)])
  // For full-text search later (pg_trgm or tsvector).
  @@index([title])
}

model View {
  id        String  @id @default(cuid())
  postId    String
  post      Post    @relation(fields: [postId], references: [id])
  ip        String?
  userAgent String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([postId])
  @@index([createdAt])
}

model Comment {
  id       String  @id @default(cuid())
  content  String
  postId   String
  authorId String
  parentId String?
  approved Boolean @default(false)

  post    Post      @relation(fields: [postId], references: [id])
  author  User      @relation(fields: [authorId], references: [id])
  parent  Comment?  @relation("CommentToComment", fields: [parentId], references: [id])
  replies Comment[] @relation("CommentToComment")
  likes   Like[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([postId])
  @@index([authorId])
  @@index([approved])
  // 2026-06-14: composite index for the per-post approved-comments list
  // (rendered in the comments section of single post pages).
  @@index([postId, approved, createdAt(sort: Desc)])
  // For the dashboard activity log (latest comments by a user).
  @@index([authorId, createdAt(sort: Desc)])
}

model Like {
  id        String  @id @default(cuid())
  userId    String
  postId    String?
  commentId String?

  user    User     @relation(fields: [userId], references: [id])
  post    Post?    @relation(fields: [postId], references: [id])
  comment Comment? @relation(fields: [commentId], references: [id])

  createdAt DateTime @default(now())

  @@unique([userId, postId, commentId])
  // 2026-06-14: per-post like counts are sorted on the archive (محبوب‌ترین)
  // and home sections. Without these, Postgres falls back to a seq scan
  // + groupBy, which is O(n) on every archive page load.
  @@index([postId, createdAt(sort: Desc)])
  @@index([commentId, createdAt(sort: Desc)])
  @@index([userId, createdAt(sort: Desc)])
}

model Category {
  id               String     @id @default(cuid())
  name             String
  slug             String     @unique
  thumbnail        String?
  posts            Post[]
  parentCategories Category[] @relation("CategoryToParent")
  childCategories  Category[] @relation("CategoryToParent")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Tag {
  id        String  @id @default(cuid())
  name      String  @unique
  slug      String  @unique
  thumbnail String?
  posts     Post[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SavedPost {
  id     String @id @default(cuid())
  userId String
  postId String

  user User @relation(fields: [userId], references: [id])
  post Post @relation(fields: [postId], references: [id])

  createdAt DateTime @default(now())

  @@unique([userId, postId])
  // 2026-06-14: used by getStats() weekly groupBy and by user profile pages.
  @@index([createdAt(sort: Desc)])
  @@index([postId, createdAt(sort: Desc)])
}

model Notification {
  id        Int      @id @default(autoincrement())
  message   String
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())

  // 2026-06-14: notification dropdowns always do
  // `findMany({ where: { userId }, orderBy: { createdAt: 'desc' }, take })`.
  // Without this index the planner had to seq-scan the whole table
  // and sort. The composite covers both the filter and the order.
  @@index([userId, createdAt(sort: Desc)])
}

model Advertisement {
  id               String     @id @default(cuid())
  title            String
  description      String?
  imageUrl         String
  linkUrl          String
  startDate        DateTime
  endDate          DateTime
  isActive         Boolean    @default(true)
  size             AdSize     @default(MEDIUM)
  position         AdPosition @default(IN_CONTENT)
  customPosition   String?
  order            Int        @default(0)
  customDimensions Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // 2026-06-14: getActiveAdvertisements filters on (isActive, startDate, endDate)
  // and orders by (position, order). Postgres needs the composite to
  // use an index-only scan; before this it was a full scan + filter.
  @@index([isActive, startDate, endDate])
  @@index([position, order])
}

model ExchangeRate {
  id          String   @id @default(cuid())
  name        String   @unique
  currency    String
  rateType    RateType @default(BUY_SELL)
  buyRate     String?
  sellRate    String?
  singleRate  String?
  bulkRate    String?
  description String?
  imageUrl    String?
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())

  // 2026-06-14: getTickerData does `orderBy: { createdAt: 'desc' } take: 5`
  // and the dashboard exchange-rates page sorts the same way. Without this
  // index the query degrades to a sort+limit on the full table.
  @@index([createdAt(sort: Desc)])
}

model RateList {
  id        String   @id @default(cuid())
  title     String
  rates     Json // Array of { title: string, value: string }
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // 2026-06-14: dashboard rate-list page filters on isActive and
  // sorts by createdAt. The composite lets it run as an index scan
  // without an extra sort step.
  @@index([isActive, createdAt(sort: Desc)])
}

model PageView {
  id    String   @id @default(cuid())
  page  String
  views Int
  date  DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // 2026-06-14: /api/pageview used to do findFirst+update+create on every
  // hit. The unique index lets us collapse it to a single upsert, and
  // the date index speeds up groupBy-by-date for the dashboard widget.
  @@unique([page])
  @@index([date])
}

model Newsletter {
  id        String   @id @default(cuid())
  email     String   @unique
  isActive  Boolean  @default(true)
  userId    String?  @unique
  user      User?    @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SystemSettings {
  id              String   @id @default(cuid())
  siteName        String?
  siteDescription String?
  maintenanceMode Boolean  @default(false)
  cacheEnabled    Boolean  @default(true)
  smtpServer      String?
  smtpPort        String?
  smtpUsername    String?
  smtpPassword    String?
  telegram        String?
  instagram       String?
  whatsapp        String?
  twitter         String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model SystemLog {
  id        String   @id @default(cuid())
  level     String // ERROR, WARNING, INFO
  message   String   @db.Text
  source    String
  timestamp DateTime @default(now())

  @@index([timestamp])
}

model ActivityLog {
  id        String   @id @default(cuid())
  userId    String
  action    String
  details   String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([createdAt])
}

model Activity {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  action    String
  details   String
  createdAt DateTime @default(now())

  @@index([userId])
}

model CurrencyPattern {
  id        String   @id @default(cuid())
  type      String // نوع الگو: currency, format, prefix, suffix, separator, multiplier
  pattern   String // الگوی ذخیره شده
  value     Float? // برای multiplier استفاده می‌شود
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([type, pattern])
}

model SocialLink {
  id        String         @id @default(cuid())
  name      String
  url       String
  icon      String?
  color     String?
  order     Int            @default(0)
  isActive  Boolean        @default(true)
  type      SocialLinkType @default(SOCIAL)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  // 2026-06-14: header/footer always render
  //   where: { type, isActive: true }, orderBy: { order: 'asc' }
  // The composite covers both the filter and the sort in one pass.
  @@index([type, isActive, order])
}

enum SocialLinkType {
  SOCIAL
  SUPPORT
}

enum ServiceRequestStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum ServiceType {
  INTERNATIONAL_TRANSFER
  ONLINE_PAYMENT
  TUITION_PAYMENT
  FREELANCE_INCOME
  SOFTWARE_PURCHASE
  OTHER
}

enum RequestUrgency {
  NORMAL
  URGENT
}

model ServiceRequest {
  id            String               @id @default(cuid())
  trackingCode  String               @unique
  fullName      String
  phone         String
  email         String?
  serviceType   ServiceType
  amount        String
  currency      String
  description   String?
  urgency       RequestUrgency       @default(NORMAL)
  contactMethod String // telegram or whatsapp
  status        ServiceRequestStatus @default(PENDING)
  adminNotes    String?
  ipAddress     String?
  userAgent     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([trackingCode])
  @@index([phone])
  @@index([status])
  @@index([createdAt])
  // 2026-06-14: composite for the duplicate-check window
  // (createServiceRequest was doing a findFirst on these four fields
  // and we want it index-only).
  @@index([phone, amount, currency, createdAt])
  // 2026-06-14: dashboard's status-grouped counts + recent-list
  // combination — covers `where: { status }, orderBy: { createdAt }`.
  @@index([status, createdAt(sort: Desc)])
}
