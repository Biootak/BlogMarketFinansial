# ===========================================
# Database (Neon — pooled for app, direct for Prisma CLI)
# ===========================================
# Pooled connection (Prisma Client / app queries) — note the -pooler hostname
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.us-east-2.aws.neon.tech/dbname?sslmode=require&channel_binding=require&connect_timeout=15"
# Direct connection (Prisma CLI: migrate / db push / db pull) — NO -pooler
DIRECT_URL="postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/dbname?sslmode=require&connect_timeout=15"

# ===========================================
# Prisma Connection Pool
# ===========================================
# Next.js static generation uses many workers in parallel. With too low a pool
# limit, builds can exhaust the Prisma connection pool and fail with:
#   "Timed out fetching a new connection from the connection pool".
# Increase these values for production builds or larger SSG page counts.
# PRISMA_CONNECTION_LIMIT: max connections in the pool. Suggested: 30 for
#   production (or 10 for local development).
PRISMA_CONNECTION_LIMIT="30"
# PRISMA_POOL_TIMEOUT: seconds to wait for a free connection before failing.
#   Suggested default: 30.
PRISMA_POOL_TIMEOUT="30"

# ===========================================
# Authentication (NextAuth)
# ===========================================
AUTH_SECRET="your-auth-secret-here"
NEXTAUTH_URL="http://localhost:3000"

# Google OAuth
AUTH_GOOGLE_ID="your-google-client-id"
AUTH_GOOGLE_SECRET="your-google-client-secret"

# GitHub OAuth
AUTH_GITHUB_ID="your-github-client-id"
AUTH_GITHUB_SECRET="your-github-client-secret"

# ===========================================
# Email (2026-06-23: provider-neutral via src/lib/email)
# ===========================================
# EMAIL_PROVIDER: 'resend' (default) | 'smtp' | 'console'
#   - resend: uses the RESEND_* vars below
#   - smtp:   uses SMTP_* vars (Mailgun / SES / Postmark / Gmail). Run
#             `npm install nodemailer` first.
#   - console: logs to stdout. Dev/test only. Throws in production.
#
# 2026-06-30 dev tip: for local development without burning Resend quota,
# set EMAIL_PROVIDER="console" — the OTP code is printed to the terminal
# (src/lib/email/console.ts) instead of being sent. Restore to "resend"
# before any staging/production deploy.
EMAIL_PROVIDER="resend"

# Resend (current default)
RESEND_API_KEY="your-resend-api-key"
RESEND_FROM="onboarding@resend.dev"

# SMTP (only needed when EMAIL_PROVIDER=smtp)
# SMTP_HOST="smtp.mailgun.org"
# SMTP_PORT="587"
# SMTP_USER="postmaster@mg.example.com"
# SMTP_PASS="your-smtp-password"
# SMTP_FROM="noreply@example.com"

# ===========================================
# File Storage (S3 Compatible)
# ===========================================
# کد از S3 API استاندارد استفاده می‌کند → هر provider سازگار با S3 جواب می‌دهد
# و مهاجرت فقط تغییر همین متغیرها است (نه تغییر کد).
#
# ⭐ پیشنهاد ۲۰۲۶: Cloudflare R2 — ۱۰GB رایگان دائمی + اگریس صفر + قابل پرداخت
#    با کریپتو (USDC روی شبکه Base/Polygon). عالی برای شروع بدون کارت بانکی.
#      S3_ENDPOINT="https://<account-id>.r2.cloudflarestorage.com"
#      S3_REGION="auto"          ← مهم برای R2
#      S3_PUBLIC_URL="https://<custom-domain>" یا "https://pub-<hash>.r2.dev"
#
#   Backblaze B2:        https://s3.<region>.backblazeb2.com
#   MinIO (self-host):   https://storage.example.com
#
S3_ENDPOINT=""
S3_ACCESS_KEY="your-access-key"
S3_SECRET_KEY="your-secret-key"
S3_BUCKET_NAME="your-bucket-name"

# Region — 'default' برای MinIO/B2، 'auto' برای Cloudflare R2 (اجباری)،
# و برای Backblaze B2 باید region واقعی endpoint (مثل us-west-004) باشد.
S3_REGION="default"

# اختیاری — URL عمومی دلخواه برای فایل‌ها. اگر ست نشود، از endpoint مشتق می‌شود
# (قالب virtual-host: https://<bucket>.<endpoint-host>). برای R2 که host عمومی
# متفاوتی دارد (دامنه اختصاصی یا pub-<hash>.r2.dev) حتماً این را ست کن:
# S3_PUBLIC_URL="https://media.your-domain.com"

# اختیاری ولی توصیه‌شده — bucket خصوصی جدا برای backup دیتابیس.
# باکت تصاویر باید public-read باشد؛ اگر backup با همان باکت برود، فایل‌های
# JSON حاوی اطلاعات کاربران در اینترنت قابل دانلود می‌شود. یک bucket خصوصی
# بساز و نامش را اینجا بگذار:
# S3_BACKUP_BUCKET="your-private-backup-bucket"

# ===========================================
# Telegram Bot
# ===========================================
TELEGRAM_BOT_TOKEN="your-telegram-bot-token"
TELEGRAM_BOT_USERNAME="your-bot-username" # بدون @ — برای لینک اتصال t.me/<username>
TELEGRAM_WEBHOOK_SECRET="random-secret" # برای webhook OTP؛ با setWebhook روی سرور ست شود
TELEGRAM_ADMIN_CHAT_ID="your-chat-id"

# ===========================================
# Sentry (Error Tracking)
# ===========================================
NEXT_PUBLIC_SENTRY_DSN="https://xxx@xxx.ingest.sentry.io/xxx"
SENTRY_ORG="your-sentry-org"
SENTRY_PROJECT="your-sentry-project"
SENTRY_AUTH_TOKEN="your-sentry-auth-token"

# ===========================================
# Upstash Redis (Rate Limiting)
# ===========================================
UPSTASH_REDIS_REST_URL="https://xxx.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your-upstash-token"

# ===========================================
# App Settings
# ===========================================
NEXT_PUBLIC_APP_URL="https://financialmarket.page"
# Canonical / OpenGraph base URL. Used by metadataBase and OG image URLs
# (src/app/layout.tsx, author/[id], authors). If omitted, the app silently
# falls back to the production domain — breaking canonical/OG on self-host.
NEXT_PUBLIC_SITE_URL="https://financialmarket.page"
ALLOWED_SETUP_IPS="127.0.0.1,::1"

# برای self-host: همون مقدار NEXTAUTH_URL را اینجا هم بگذار.
# اگه خالی بگذاری، به‌طور پیش‌فرض https://financialmarket.page استفاده می‌شه.
# در production حتماً دامنه‌ی واقعی را بگذار (مثلاً https://financialmarket.page).
APP_URL="https://financialmarket.page"

# ===========================================
# CSRF (Server Actions)
# ===========================================
# لیست میزبان‌های مجاز برای Origin check در assertCsrf (src/lib/csrf-server.ts).
# جدا با کاما. پیش‌فرض کد شامل financialmarket.page و blogmarketfinansial.ir
# (دامنه تولید) و localhost است — فقط اگر دامنه/ساب‌دامنه دیگری داری این را بگذار:
# CSRF_ALLOWED_HOSTS="staging.example.com,www.staging.example.com"

# Timezone برای schedule پست‌ها و لاگ‌ها. پیش‌فرض: Asia/Tehran
TZ="Asia/Tehran"

# نرخ‌های بازار آزاد تیکر (دلار، یورو، طلا، سکه)
# به‌صورت خودکار از منابع رایگان عمومی گرفته می‌شه؛ نیازی به کلید نیست:
#   1) USD/Toman از قیمت تتر (Exir — درون پروژه)
#   2) سایر ارزها از FX جهانی (exchangerate-api.com — رایگان)
#   3) طلا/سکه از جدول ExchangeRate (ادمین در داشبورد وارد می‌کنه)
#   4) TGJU scraper (cron هر ۱۰ دقیقه) — دلار، یورو، سکه، طلا، نفت

# ضریب طلایی تتر (فاصله‌ی تتر با دلار بازار آزاد)
# در بازار عادی معمولاً بین ۰.۵٪ تا ۲٪. ادمین می‌تونه با داشتن USD در DB و
# نگاه کردن به لاگ «premium check» مقدار واقعی بازار محلی‌ش رو تنظیم کنه.
# پیش‌فرض: ۰ (بدون ضریب)
USDT_PREMIUM_PERCENT="1.5"

# ===========================================
# Cron Secret (for all /api/cron/* endpoints)
# ----------------------------------------------------------------------------
# محافظت از سه endpoint:
#   - /api/cron/publish-scheduled-posts
#   - /api/cron/refresh-market-rates
#   - /api/cron/sync-bazaar
#
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# یا:      npm run deploy:secret
#
# در صورت تنظیم نبودن، endpoint غیرفعال (503) می‌ماند.
#
# روش‌های فراخوانی (هر کدام معتبر):
#   1) هدر:    Authorization: Bearer ${CRON_SECRET}
#   2) هدر:    x-cron-secret: ${CRON_SECRET}
#   3) query:   ?secret=${CRON_SECRET}
#
# برای self-host:
#   - در docker-compose سرویس cron خودش مقدار را می‌خواند.
#   - در نصب PM2، crontab را از deploy/crontab.example کپی و مقدار را جایگزین کن.
# ===========================================
CRON_SECRET=""

# غیرفعال کردن scraper بدون redeploy. پیش‌فرض: true.
# اگر false، endpoint و assembleFreeMarketRates به USDT-derived + FX + DB fallback می‌روند.
TGJU_SCRAPER_ENABLED="true"

# ===========================================
# Debug Mode
# ===========================================
DEBUG_MODE="false"  # Set to "true" to enable middleware debug logging

# ===========================================
# Seed (dev only)
# ===========================================
# Optional credentials for the seeded OWNER (مالک).
# If SEED_OWNER_PASSWORD is not set, a strong random password is
# generated and printed to the console only on first seed.
SEED_OWNER_EMAIL="Admin@gmail.com"
# SEED_OWNER_PASSWORD="YourStrongPassword123!"

# ===========================================
# Docker Compose (only used by docker-compose.yml)
# ----------------------------------------------------------------------------
# فقط وقتی از docker compose استفاده می‌کنی لازمه. اگه Postgres
# بیرون از داکر است (مثلاً Neon یا سرور جدا)، این‌ها لازم نیست.
# ===========================================
# POSTGRES_USER="blog_owner"
# POSTGRES_PASSWORD="change-me-strong-password"
# POSTGRES_DB="blog"

# Preview mode for the /setup wizard UI in development.
# When "true", the wizard is rendered even if a super-admin already exists,
# so the page can be redesigned/tested without resetting the database.
# This flag is ignored in production and the server action still refuses
# to create a duplicate super-admin.
SETUP_PREVIEW_MODE="false"
