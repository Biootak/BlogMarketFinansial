# ===========================================
# Database
# ===========================================
DATABASE_URL="postgresql://user:password@localhost:5432/biotak"

# ===========================================
# Authentication (NextAuth)
# ===========================================
AUTH_SECRET="your-auth-secret-here"
NEXTAUTH_URL="http://localhost:3000"

# Google OAuth
AUTH_GOOGLE_ID="your-google-client-id"
AUTH_GOOGLE_SECRET="your-google-client-secret"

# GitHub OAuth
AUTH_GITHUB_ID="your-github-client-id"
AUTH_GITHUB_SECRET="your-github-client-secret"

# ===========================================
# Email (2026-06-23: provider-neutral via src/lib/email)
# ===========================================
# EMAIL_PROVIDER: 'resend' (default) | 'smtp' | 'console'
#   - resend: uses the RESEND_* vars below
#   - smtp:   uses SMTP_* vars (Mailgun / SES / Postmark / Gmail). Run
#             `npm install nodemailer` first.
#   - console: logs to stdout. Dev/test only. Throws in production.
EMAIL_PROVIDER="resend"

# Resend (current default)
RESEND_API_KEY="your-resend-api-key"
RESEND_FROM="onboarding@resend.dev"

# SMTP (only needed when EMAIL_PROVIDER=smtp)
# SMTP_HOST="smtp.mailgun.org"
# SMTP_PORT="587"
# SMTP_USER="postmaster@mg.example.com"
# SMTP_PASS="your-smtp-password"
# SMTP_FROM="noreply@example.com"

# ===========================================
# File Storage (S3 Compatible - Liara)
# ===========================================
LIARA_ENDPOINT="https://storage.c2.liara.space"
LIARA_ACCESS_KEY="your-access-key"
LIARA_SECRET_KEY="your-secret-key"
LIARA_BUCKET_NAME="your-bucket-name"

# ===========================================
# Telegram Bot
# ===========================================
TELEGRAM_BOT_TOKEN="your-telegram-bot-token"
TELEGRAM_ADMIN_CHAT_ID="your-chat-id"

# ===========================================
# Sentry (Error Tracking)
# ===========================================
NEXT_PUBLIC_SENTRY_DSN="https://xxx@xxx.ingest.sentry.io/xxx"
SENTRY_ORG="your-sentry-org"
SENTRY_PROJECT="your-sentry-project"
SENTRY_AUTH_TOKEN="your-sentry-auth-token"

# ===========================================
# Upstash Redis (Rate Limiting)
# ===========================================
UPSTASH_REDIS_REST_URL="https://xxx.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your-upstash-token"

# ===========================================
# App Settings
# ===========================================
NEXT_PUBLIC_APP_URL="http://localhost:3000"
ALLOWED_SETUP_IPS="127.0.0.1,::1"

# نرخ‌های بازار آزاد تیکر (دلار، یورو، طلا، سکه)
# به‌صورت خودکار از منابع رایگان عمومی گرفته می‌شه؛ نیازی به کلید نیست:
#   1) USD/Toman از قیمت تتر (Exir — درون پروژه)
#   2) سایر ارزها از FX جهانی (exchangerate-api.com — رایگان)
#   3) طلا/سکه از جدول ExchangeRate (ادمین در داشبورد وارد می‌کنه)
#   4) TGJU scraper (cron هر ۱۰ دقیقه) — دلار، یورو، سکه، طلا، نفت

# ضریب طلایی تتر (فاصله‌ی تتر با دلار بازار آزاد)
# در بازار عادی معمولاً بین ۰.۵٪ تا ۲٪. ادمین می‌تونه با داشتن USD در DB و
# نگاه کردن به لاگ «premium check» مقدار واقعی بازار محلی‌ش رو تنظیم کنه.
# پیش‌فرض: ۰ (بدون ضریب)
USDT_PREMIUM_PERCENT="1.5"

# ===========================================
# Cron Secret (for /api/cron/sync-bazaar)
# محافظت از endpoint که TGJU را scrape می‌کند و در DB upsert می‌کند.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# در صورت تنظیم نبودن، endpoint غیرفعال (503) می‌ماند.
# Vercel Cron: در Authorization: Bearer ${CRON_SECRET} هدر بفرست
# Manual test: ?secret=${CRON_SECRET}
# ===========================================
CRON_SECRET=""

# غیرفعال کردن scraper بدون redeploy. پیش‌فرض: true.
# اگر false، endpoint و assembleFreeMarketRates به USDT-derived + FX + DB fallback می‌روند.
TGJU_SCRAPER_ENABLED="true"

# ===========================================
# Debug Mode
# ===========================================
DEBUG_MODE="false"  # Set to "true" to enable middleware debug logging
