{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    ".next-lh/types/**/*.ts",
    ".next-lh/dev/types/**/*.ts",
    ".next-build/types/**/*.ts",
    ".next-build/dev/types/**/*.ts",
    ".next-bundle-audit/types/**/*.ts",
    ".next-bundle-audit/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    ".next/cache",
    ".next/server",
    ".next/static",
    ".next/standalone",
    ".next/dev/types",
    // 2026-08-02: perf-out/ is generated build output (like .next) — it was
    // swept into the typecheck program by the **/*.ts glob, and its stale
    // copy of scripts/verify-freeMarketRates.ts (a global-scope script)
    // collided with the real one, breaking `npm run verify` with ~20
    // duplicate-identifier errors.
    "perf-out"
  ]
}
