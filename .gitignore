# Development tools
.aider*
.opencode/
.worktrees/

# Lighthouse reports
/lighthouse-*.report.html
/lighthouse-*.report.json
/.lighthouse-tmp/

# Sentry
.sentryclirc
.vercel
.env*

# Large external theme assets / harness metadata
/Orchis-theme/
/WhiteSur-gtk-theme/
/.kimchi/ferments/

# Graphify MCP knowledge graph (regenerated from source; not source-controlled)
/graphify-out/
/.graphify-bak-images/
/.mcp.json

# 2026-07-06: codegraph MCP cache (SQLite DB + daemon state). Regenerated
# from source on demand; tracked nowhere else. The 16MB `codegraph.db`
# alone is enough reason to keep this out of git — it bloats `git status`
# and inflates every shallow clone.
/.codegraph/

# 2026-07-06: Playwright artifacts. The HTML report and per-test JSON
# outputs are regenerated on every `playwright test` run, so they're
# noise in the working tree.
/playwright-report/
/test-results/
/.playwright/

# TGJU scraper debug HTML dumps (regenerated on demand via TGJU_DEBUG_DUMP=1)
/.tgju-debug/

# Public dev/visual reports (regenerated on demand via scripts/build-tgju-visual.mjs)
/public/dev-tools/
