# Heroku-specific Dockerfile — از docker hub مستقیم (نه mirror ایرانی)
# این فایل فقط برای Heroku Container Registry استفاده می‌شود.
# برای self-hosted Docker Compose از Dockerfile اصلی استفاده کن.

# ─── Stage 1: Dependencies ───────────────────────────────────────────────────
FROM node:22-alpine AS deps
RUN apk add --no-cache libc6-compat
WORKDIR /app

COPY package.json yarn.lock* package-lock.json* pnpm-lock.yaml* ./
COPY prisma ./prisma

ENV PRISMA_SKIP_POSTINSTALL_GENERATE=1
# postinstall اجرای migrate را در build time بلاک می‌کند
ENV SKIP_POSTINSTALL=1

RUN if [ -f yarn.lock ]; then \
      yarn --frozen-lockfile --ignore-scripts; \
    elif [ -f package-lock.json ]; then \
      npm ci --no-audit --no-fund --ignore-scripts; \
    else \
      npm install --ignore-scripts; \
    fi

RUN mkdir -p node_modules/.prisma/client && \
    for i in 1 2 3; do \
      npx prisma generate --schema=./prisma/schema.prisma && break || \
      (echo "Retrying Prisma generate... Attempt $i" && sleep 5); \
    done

# ─── Stage 2: Builder ────────────────────────────────────────────────────────
FROM node:22-alpine AS builder
WORKDIR /app

# DATABASE_URL در build time برای Prisma لازم است
# در Heroku این به‌صورت build arg ست می‌شود (از GitHub Actions)
ARG DATABASE_URL
ENV DATABASE_URL=$DATABASE_URL
# Prisma schema نیاز به DIRECT_URL دارد (برای مهاجرت مستقیم به DB).
# در build-time همان DATABASE_URL کافی است — مقادیر runtime در Heroku
# جدا ست می‌شوند (Config Vars).
ENV DIRECT_URL=$DATABASE_URL
# رمز OWNER برای seed اولیه (اختیاری — اگر خالی باشد seed رمز تصادفی می‌سازد)
ARG SEED_OWNER_PASSWORD
ENV SEED_OWNER_PASSWORD=$SEED_OWNER_PASSWORD
# AUTH_SECRET برای build-time لازم است: auth.ts در NODE_ENV=production
# fail-closed است و route های 2FA (src/app/api/2fa/qr) در build-time collect
# می‌شوند و auth را import می‌کنند — بدون secret، next build با
# «AUTH_SECRET is required in production» شکست می‌خورد.
# مقدار از Heroku config خوانده می‌شود (منبع حقیقت — مثل DATABASE_URL).
ARG AUTH_SECRET
ENV AUTH_SECRET=$AUTH_SECRET

# فعال‌سازی standalone output برای Heroku
ENV OUTPUT_STANDALONE=1
ENV NEXT_TELEMETRY_DISABLED=1
ENV NODE_ENV=production

COPY --from=deps /app/node_modules ./node_modules
COPY . .

# 2026-08-08: migrations را قبل از build اعمال کن. صفحات ISR/استاتیک در build-time
# به DB وصل می‌شوند (generateStaticParams، getSidebarData و ...) — اگر جدول‌ها
# هنوز ساخته نشده باشند، build با «table does not exist» شکست می‌خورد.
# (قبلاً migrate deploy فقط در runtime اجرا می‌شد که خیلی دیر بود.)
RUN npx prisma migrate deploy --schema=./prisma/schema.prisma

# 2026-08-08: seed اولیه روی DB خالی (idempotent — چندبار اجرا بی‌ضرر است).
# این مرحله فقط در build اجرا می‌شود؛ runtime داده را از DB می‌خواند.
RUN node prisma/seed.js && npx tsx prisma/seed-market-rates.ts || echo "seed skipped (DB not empty or transient error)"

RUN npm run build

# ─── Stage 3: Runner ─────────────────────────────────────────────────────────
FROM node:22-alpine AS runner
WORKDIR /app

ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
# 2026-08-13 mem-fix: Cap V8 old-space at 256MB so Heroku Eco dyno (512MB RSS)
# has headroom before R14 (>512MB) or R15 (>1.5x dyno size → restart).
# Without this flag, Node defaults to ~1.4GB heap limit and can grow past 512MB
# before GC kicks in — triggering R14 on every cold-start with a warm cache.
# Keep in sync with NODE_OPTIONS in app.json.
ENV NODE_OPTIONS="--max-old-space-size=256"

RUN addgroup --system --gid 1001 nodejs && \
    adduser --system --uid 1001 nextjs && \
    mkdir -p .next public/uploads/posts public/uploads/avatars \
             public/uploads/categories public/uploads/tags \
             public/uploads/ads public/uploads/general && \
    chown -R nextjs:nodejs .next public/uploads

COPY --from=builder /app/public ./public
COPY --from=builder --chown=nextjs:nodejs /app/.next/standalone ./
COPY --from=builder --chown=nextjs:nodejs /app/.next/static ./.next/static
COPY --from=builder --chown=nextjs:nodejs /app/node_modules/.prisma ./node_modules/.prisma
COPY --from=builder --chown=nextjs:nodejs /app/node_modules/@prisma/client ./node_modules/@prisma/client
COPY --from=builder --chown=nextjs:nodejs /app/node_modules/sharp ./node_modules/sharp
COPY --from=builder --chown=nextjs:nodejs /app/prisma ./prisma

USER nextjs

# Heroku از PORT env var استفاده می‌کند (نه ثابت 3000)
ENV PORT=${PORT:-3000}
ENV HOSTNAME="0.0.0.0"

# 2026-08-08: migrations فقط در build-time اجرا می‌شوند
# (RUN npx prisma migrate deploy در stage builder با DATABASE_URL واقعی
# production که CI از Heroku می‌خواند). runtime migrate حذف شد — کپی دستی
# prisma CLI و وابستگی‌هایش (effect و ...) به runner شکننده بود و در boot
# با MODULE_NOT_FOUND کرش می‌کرد. runtime فقط server.js (standalone).
CMD ["node", "server.js"]
