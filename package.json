    "dev:local": "cross-env DATABASE_URL=postgresql://blog_owner:I82HcwNASRPe@localhost:15432/blog?sslmode=disable DIRECT_URL=postgresql://blog_owner:I82HcwNASRPe@localhost:15432/blog?sslmode=disable NEXTAUTH_URL=http://localhost:3000 NODE_OPTIONS=--dns-result-order=ipv4first next dev",
