  "private": true,
  "scripts": {
    "dev": "cross-env NODE_OPTIONS=--dns-result-order=ipv4first next dev",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "biome check .",
    "postinstall": "prisma generate",
    "db:seed": "node prisma/seed.js",
    "db:reset": "node scripts/reset-and-seed-50-posts.js",
