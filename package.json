    "db:up": "docker-compose up -d db",
    "db:down": "docker-compose down",
    "db:push:local": "cross-env DATABASE_URL=postgresql://blog_owner:I82HcwNASRPe@localhost:15432/blog?sslmode=disable DIRECT_URL=postgresql://blog_owner:I82HcwNASRPe@localhost:15432/blog?sslmode=disable prisma db push --accept-data-loss",
    "db:seed:local": "cross-env DATABASE_URL=postgresql://blog_owner:I82HcwNASRPe@localhost:15432/blog?sslmode=disable DIRECT_URL=postgresql://blog_owner:I82HcwNASRPe@localhost:15432/blog?sslmode=disable node prisma/seed.js",
