    "assets:optimize:dry": "node scripts/optimize-assets.mjs --dry-run",
    "assets:optimize:force": "node scripts/optimize-assets.mjs --force",
    "deploy:build": "next build",
    "deploy:start": "pm2 start deploy/ecosystem.config.cjs --env production",
    "deploy:stop": "pm2 stop fm-blog",
    "deploy:restart": "pm2 restart fm-blog",
    "deploy:reload": "pm2 reload fm-blog",
    "deploy:rebuild": "npm ci && prisma generate && npm run build && pm2 restart fm-blog",
    "deploy:logs": "pm2 logs fm-blog",
    "deploy:status": "pm2 status",
    "deploy:secret": "node -e \"console.log(require('crypto').randomBytes(32).toString('hex'))\"",
    "cron:test:scheduled": "curl -fsS -H \"Authorization: Bearer ${CRON_SECRET}\" ${APP_URL:-http://localhost:3000}/api/cron/publish-scheduled-posts",
    "cron:test:rates": "curl -fsS -H \"Authorization: Bearer ${CRON_SECRET}\" ${APP_URL:-http://localhost:3000}/api/cron/refresh-market-rates",
    "cron:test:bazaar": "curl -fsS -H \"Authorization: Bearer ${CRON_SECRET}\" ${APP_URL:-http://localhost:3000}/api/cron/sync-bazaar",
